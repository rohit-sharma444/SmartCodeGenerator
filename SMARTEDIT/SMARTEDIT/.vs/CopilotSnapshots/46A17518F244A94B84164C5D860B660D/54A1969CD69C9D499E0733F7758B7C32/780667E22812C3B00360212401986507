using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;

namespace SMARTEDIT;

public class MainForm : Form
{
    private TabControl tabControl;
    private StatusStrip statusStrip;
    private ToolStripStatusLabel statusLabel;
    private System.Windows.Forms.Timer autoSaveTimer;

    public MainForm()
    {
        InitializeUI();
        CreateNewTab();
    }

    private void InitializeUI()
    {
        Text = "Smart Edit";
        Width = 1200;
        Height = 800;
        StartPosition = FormStartPosition.CenterScreen;

        MenuStrip menu = new MenuStrip();

        #region File Menu

        ToolStripMenuItem fileMenu = new ToolStripMenuItem("File");

        ToolStripMenuItem newItem = new ToolStripMenuItem("New");
        newItem.ShortcutKeys = Keys.Control | Keys.N;
        newItem.Click += (s, e) => CreateNewTab();

        ToolStripMenuItem openItem = new ToolStripMenuItem("Open");
        openItem.ShortcutKeys = Keys.Control | Keys.O;
        openItem.Click += OpenFile;

        ToolStripMenuItem saveItem = new ToolStripMenuItem("Save");
        saveItem.ShortcutKeys = Keys.Control | Keys.S;
        saveItem.Click += SaveFile;

        ToolStripMenuItem saveAsItem = new ToolStripMenuItem("Save As");
        saveAsItem.Click += SaveAsFile;

        ToolStripMenuItem exitItem = new ToolStripMenuItem("Exit");
        exitItem.Click += (s, e) => Close();

        fileMenu.DropDownItems.Add(newItem);
        fileMenu.DropDownItems.Add(openItem);
        fileMenu.DropDownItems.Add(saveItem);
        fileMenu.DropDownItems.Add(saveAsItem);
        fileMenu.DropDownItems.Add(new ToolStripSeparator());
        fileMenu.DropDownItems.Add(exitItem);

        #endregion

        #region Edit Menu

        ToolStripMenuItem editMenu = new ToolStripMenuItem("Edit");

        ToolStripMenuItem findItem = new ToolStripMenuItem("Find");
        findItem.ShortcutKeys = Keys.Control | Keys.F;
        findItem.Click += FindText;

        ToolStripMenuItem replaceItem = new ToolStripMenuItem("Replace");
        replaceItem.ShortcutKeys = Keys.Control | Keys.H;
        replaceItem.Click += ReplaceText;

        editMenu.DropDownItems.Add(findItem);
        editMenu.DropDownItems.Add(replaceItem);

        #endregion

        #region View Menu

        ToolStripMenuItem viewMenu = new ToolStripMenuItem("View");

        ToolStripMenuItem darkModeItem = new ToolStripMenuItem("Dark Mode");
        darkModeItem.CheckOnClick = true;
        darkModeItem.CheckedChanged += ToggleDarkMode;

        ToolStripMenuItem fontItem = new ToolStripMenuItem("Font");
        fontItem.Click += ChangeFont;

        viewMenu.DropDownItems.Add(darkModeItem);
        viewMenu.DropDownItems.Add(fontItem);

        #endregion

        menu.Items.Add(fileMenu);
        menu.Items.Add(editMenu);
        menu.Items.Add(viewMenu);

        Controls.Add(menu);
        MainMenuStrip = menu;

        tabControl = new TabControl();
        tabControl.Dock = DockStyle.Fill;
        Controls.Add(tabControl);

        statusStrip = new StatusStrip();
        statusLabel = new ToolStripStatusLabel("Ready");
        statusStrip.Items.Add(statusLabel);
        Controls.Add(statusStrip);

        autoSaveTimer = new System.Windows.Forms.Timer();
        autoSaveTimer.Interval = 30000;
        autoSaveTimer.Tick += AutoSave;
        autoSaveTimer.Start();
    }

    private RichTextBox GetCurrentEditor()
    {
        if (tabControl.SelectedTab == null)
            return null;

        return tabControl.SelectedTab.Controls[0] as RichTextBox;
    }

    private void CreateNewTab()
    {
        TabPage page = new TabPage("Untitled");

        RichTextBox editor = new RichTextBox();
        editor.Dock = DockStyle.Fill;
        editor.Font = new Font("Consolas", 12);
        editor.AcceptsTab = true;
        editor.WordWrap = true;

        editor.SelectionChanged += UpdateStatus;
        editor.TextChanged += UpdateStatus;

        page.Controls.Add(editor);
        page.Tag = "";

        tabControl.TabPages.Add(page);
        tabControl.SelectedTab = page;
    }

    private void OpenFile(object sender, EventArgs e)
    {
        OpenFileDialog dialog = new OpenFileDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            CreateNewTab();

            RichTextBox editor = GetCurrentEditor();

            editor.Text = File.ReadAllText(dialog.FileName);

            tabControl.SelectedTab.Text = Path.GetFileName(dialog.FileName);
            tabControl.SelectedTab.Tag = dialog.FileName;

            statusLabel.Text = "File opened";
        }
    }

    private void SaveFile(object sender, EventArgs e)
    {
        if (tabControl.SelectedTab == null)
            return;

        string path = tabControl.SelectedTab.Tag?.ToString();

        if (string.IsNullOrEmpty(path))
        {
            SaveAsFile(sender, e);
            return;
        }

        File.WriteAllText(path, GetCurrentEditor().Text);
        statusLabel.Text = "File saved";
    }

    private void SaveAsFile(object sender, EventArgs e)
    {
        SaveFileDialog dialog = new SaveFileDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            File.WriteAllText(dialog.FileName, GetCurrentEditor().Text);

            tabControl.SelectedTab.Text = Path.GetFileName(dialog.FileName);
            tabControl.SelectedTab.Tag = dialog.FileName;

            statusLabel.Text = "File saved";
        }
    }

    private void ToggleDarkMode(object sender, EventArgs e)
    {
        ToolStripMenuItem item = sender as ToolStripMenuItem;

        bool dark = item.Checked;

        foreach (TabPage page in tabControl.TabPages)
        {
            RichTextBox editor = page.Controls[0] as RichTextBox;

            if (dark)
            {
                editor.BackColor = Color.FromArgb(30, 30, 30);
                editor.ForeColor = Color.White;
            }
            else
            {
                editor.BackColor = Color.White;
                editor.ForeColor = Color.Black;
            }
        }
    }

    private void ChangeFont(object sender, EventArgs e)
    {
        FontDialog dialog = new FontDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            GetCurrentEditor().Font = dialog.Font;
        }
    }

    private void FindText(object sender, EventArgs e)
    {
        string search = Microsoft.VisualBasic.Interaction.InputBox(
            "Find What:",
            "Find",
            "");

        if (string.IsNullOrEmpty(search))
            return;

        RichTextBox editor = GetCurrentEditor();

        int index = editor.Text.IndexOf(search, StringComparison.OrdinalIgnoreCase);

        if (index >= 0)
        {
            editor.Select(index, search.Length);
            editor.ScrollToCaret();
            editor.Focus();
        }
        else
        {
            MessageBox.Show("Text not found");
        }
    }

    private void ReplaceText(object sender, EventArgs e)
    {
        string find = Microsoft.VisualBasic.Interaction.InputBox(
            "Find:",
            "Replace",
            "");

        if (string.IsNullOrEmpty(find))
            return;

        string replace = Microsoft.VisualBasic.Interaction.InputBox(
            "Replace With:",
            "Replace",
            "");

        RichTextBox editor = GetCurrentEditor();

        editor.Text = editor.Text.Replace(find, replace);
    }

    private void UpdateStatus(object sender, EventArgs e)
    {
        RichTextBox editor = GetCurrentEditor();

        int line = editor.GetLineFromCharIndex(editor.SelectionStart) + 1;
        int column = editor.SelectionStart - editor.GetFirstCharIndexOfCurrentLine() + 1;

        statusLabel.Text = $"Line: {line}  Column: {column}";
    }

    private void AutoSave(object sender, EventArgs e)
    {
        if (tabControl.SelectedTab == null)
            return;

        string path = tabControl.SelectedTab.Tag?.ToString();

        if (!string.IsNullOrEmpty(path))
        {
            File.WriteAllText(path, GetCurrentEditor().Text);
            statusLabel.Text = "Auto saved";
        }
    }
}