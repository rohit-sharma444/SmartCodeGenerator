    private RichTextBox GetCurrentEditor()
    {
        if (tabControl.SelectedTab == null)
            return null;

        return tabControl.SelectedTab.Controls[0] as RichTextBox;
    }

    private void SuggestInline()
    {
        RichTextBox editor = GetCurrentEditor();

        if (editor == null)
            return;

        // Simple stub: take current line and ask AI for suggestion
        int lineIndex = editor.GetLineFromCharIndex(editor.SelectionStart);
        int lineStart = editor.GetFirstCharIndexFromLine(lineIndex);
        int lineLength = editor.Lines.Length > lineIndex ? editor.Lines[lineIndex].Length : 0;
        string currentLine = editor.Lines.Length > lineIndex ? editor.Lines[lineIndex] : "";

        string suggestion = GenerateInlineSuggestion(currentLine, editor.Text);

        // Show ghost text overlay near caret
        currentSuggestion = suggestion;

        if (aiGhostLabel == null)
        {
            aiGhostLabel = new Label();
            aiGhostLabel.AutoSize = true;
            aiGhostLabel.ForeColor = Color.Gray;
            aiGhostLabel.BackColor = Color.Transparent;
            aiGhostLabel.Font = editor.Font;
            aiGhostLabel.Padding = new Padding(0);
            aiGhostLabel.Margin = new Padding(0);
        }

        aiGhostLabel.Text = TruncateForMenu(suggestion, 200);

        // position the label at the caret
        Point caretPos = editor.GetPositionFromCharIndex(editor.SelectionStart);
        caretPos.Offset(2, (int)editor.Font.GetHeight());

        // Ensure label is parented to the editor's parent so it overlays correctly
        if (aiGhostLabel.Parent != editor)
        {
            editor.Controls.Add(aiGhostLabel);
            aiGhostLabel.BringToFront();
        }

        aiGhostLabel.Location = caretPos;

        // Hook to hide on typing or moving
        editor.KeyDown -= Editor_KeyDown_ForSuggestion;
        editor.KeyDown += Editor_KeyDown_ForSuggestion;
        editor.MouseDown -= Editor_MouseDown_ForSuggestion;
        editor.MouseDown += Editor_MouseDown_ForSuggestion;
    }

    private void InsertSuggestionAtCaret(RichTextBox editor, string suggestion)
    {
        int selStart = editor.SelectionStart;
        editor.Text = editor.Text.Insert(selStart, suggestion);
        editor.SelectionStart = selStart + suggestion.Length;
        editor.Focus();
    }

    private string TruncateForMenu(string text, int max = 60)
    {
        if (string.IsNullOrEmpty(text)) return "(no suggestion)";
        if (text.Length <= max) return text.Replace("\r\n", " ").Replace('\n', ' ');
        return text.Substring(0, max - 3).Replace("\r\n", " ").Replace('\n', ' ') + "...";
    }

    // Simple local suggestion generator (stub). Replace with real AI call later.
    private string GenerateInlineSuggestion(string currentLine, string fullText)
    {
        if (string.IsNullOrWhiteSpace(currentLine))
            return "// TODO: Add code...";

        // If the line ends with an opening brace, suggest a closing brace
        if (currentLine.TrimEnd().EndsWith("{") )
        {
            return "\n\t\n}";
        }

        // Basic completion: mirror common endings
        if (currentLine.Trim().EndsWith("public") || currentLine.Trim().EndsWith("private") || currentLine.Trim().EndsWith("protected"))
        {
            return " void MethodName() { }";
        }

        // Fallback: suggest a comment continuation
        return " // suggestion";
    }

    private void CreateNewTab()
    {
        TabPage page = new TabPage("Untitled");

        RichTextBox editor = new RichTextBox();
        editor.Dock = DockStyle.Fill;
        editor.Font = new Font("Consolas", 12);
        editor.AcceptsTab = true;
        editor.WordWrap = true;

        editor.SelectionChanged += UpdateStatus;
        editor.TextChanged += UpdateStatus;
        // ensure any existing ghost is removed when switching/creating
        editor.Disposed += (s, e) => {
            if (aiGhostLabel != null && aiGhostLabel.Parent == s as Control)
            {
                aiGhostLabel.Dispose();
                aiGhostLabel = null;
                currentSuggestion = null;
            }
        };

        // Accept suggestion with Tab
        editor.KeyDown += (s, e) => {
            if (e.KeyCode == Keys.Tab && !string.IsNullOrEmpty(currentSuggestion) && inlineAiEnabled)
            {
                InsertSuggestionAtCaret(editor, currentSuggestion);
                e.Handled = true;
                e.SuppressKeyPress = true;
            }
        };


        page.Controls.Add(editor);
        page.Tag = "";

        tabControl.TabPages.Add(page);
        tabControl.SelectedTab = page;
    }

    private void OpenFile(object sender, EventArgs e)
    {
        OpenFileDialog dialog = new OpenFileDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            CreateNewTab();

            RichTextBox editor = GetCurrentEditor();

            editor.Text = File.ReadAllText(dialog.FileName);

            tabControl.SelectedTab.Text = Path.GetFileName(dialog.FileName);
            tabControl.SelectedTab.Tag = dialog.FileName;

            statusLabel.Text = "File opened";
        }
    }

    private void SaveFile(object sender, EventArgs e)
    {
        if (tabControl.SelectedTab == null)
            return;

        string path = tabControl.SelectedTab.Tag?.ToString();

        if (string.IsNullOrEmpty(path))
        {
            SaveAsFile(sender, e);
            return;
        }

        File.WriteAllText(path, GetCurrentEditor().Text);
        statusLabel.Text = "File saved";
    }

    private void SaveAsFile(object sender, EventArgs e)
    {
        SaveFileDialog dialog = new SaveFileDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            File.WriteAllText(dialog.FileName, GetCurrentEditor().Text);

            tabControl.SelectedTab.Text = Path.GetFileName(dialog.FileName);
            tabControl.SelectedTab.Tag = dialog.FileName;

            statusLabel.Text = "File saved";
        }
    }

    private void ToggleDarkMode(object sender, EventArgs e)
    {
        ToolStripMenuItem item = sender as ToolStripMenuItem;

        bool dark = item.Checked;

        foreach (TabPage page in tabControl.TabPages)
        {
            RichTextBox editor = page.Controls[0] as RichTextBox;

            if (dark)
            {
                editor.BackColor = Color.FromArgb(30, 30, 30);
                editor.ForeColor = Color.White;
            }
            else
            {
                editor.BackColor = Color.White;
                editor.ForeColor = Color.Black;
            }
        }
    }

    private void ChangeFont(object sender, EventArgs e)
    {
        FontDialog dialog = new FontDialog();

        if (dialog.ShowDialog() == DialogResult.OK)
        {
            GetCurrentEditor().Font = dialog.Font;
        }
    }

    private void FindText(object sender, EventArgs e)
    {
        string search = Microsoft.VisualBasic.Interaction.InputBox(
            "Find What:",
            "Find",
            "");

        if (string.IsNullOrEmpty(search))
            return;

        RichTextBox editor = GetCurrentEditor();

        int index = editor.Text.IndexOf(search, StringComparison.OrdinalIgnoreCase);

        if (index >= 0)
        {
            editor.Select(index, search.Length);
            editor.ScrollToCaret();
            editor.Focus();
        }
        else
        {
            MessageBox.Show("Text not found");
        }
    }

    private void ReplaceText(object sender, EventArgs e)
    {
        string find = Microsoft.VisualBasic.Interaction.InputBox(
            "Find:",
            "Replace",
            "");

        if (string.IsNullOrEmpty(find))
            return;

        string replace = Microsoft.VisualBasic.Interaction.InputBox(
            "Replace With:",
            "Replace",
            "");

        RichTextBox editor = GetCurrentEditor();

        editor.Text = editor.Text.Replace(find, replace);
    }

    private void UpdateStatus(object sender, EventArgs e)
    {
        RichTextBox editor = GetCurrentEditor();

        int line = editor.GetLineFromCharIndex(editor.SelectionStart) + 1;
        int column = editor.SelectionStart - editor.GetFirstCharIndexOfCurrentLine() + 1;

        statusLabel.Text = $"Line: {line}  Column: {column}";
    }

    private void AutoSave(object sender, EventArgs e)
    {
        if (tabControl.SelectedTab == null)
            return;

        string path = tabControl.SelectedTab.Tag?.ToString();

        if (!string.IsNullOrEmpty(path))
        {
            File.WriteAllText(path, GetCurrentEditor().Text);
            statusLabel.Text = "Auto saved";
        }
    }
}