namespace CodeCommenterPro.Roslyn;

using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp.Syntax;

public static class PatternCommentGenerator
{
    public static string? Generate(
        SyntaxNode node)
    {
        string text = node.ToString();

        if (text.Contains("repository.Get"))
            return "Retrieve data from repository";

        if (text.Contains("repository.Find"))
            return "Find matching data";

        if (text.Contains("repository.Save"))
            return "Persist data";

        if (text.Contains("repository.Delete"))
            return "Delete data";

        if (text.Contains("logger.Log"))
            return "Write log entry";

        if (text.Contains("LogInformation"))
            return "Write informational log";

        if (text.Contains("LogError"))
            return "Write error log";

        if (text.Contains("File.ReadAllText"))
            return "Read file contents";

        if (text.Contains("File.ReadAllBytes"))
            return "Read file bytes";

        if (text.Contains("File.WriteAllText"))
            return "Write file contents";

        if (text.Contains("File.WriteAllBytes"))
            return "Write file bytes";

        if (text.Contains("JsonSerializer.Deserialize"))
            return "Deserialize object";

        if (text.Contains("JsonSerializer.Serialize"))
            return "Serialize object";

        if (text.Contains("SaveChanges"))
            return "Commit database changes";

        if (text.Contains("GetAsync"))
            return "Execute asynchronous request";

        if (text.Contains("PostAsync"))
            return "Send asynchronous request";

        if (text.Contains("PutAsync"))
            return "Update remote resource";

        if (text.Contains("DeleteAsync"))
            return "Delete remote resource";

        return null;
    }
}