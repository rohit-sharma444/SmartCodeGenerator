namespace CodeCommenterPro.Roslyn;

using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp;
using Microsoft.CodeAnalysis.CSharp.Syntax;

public class LogicCommentRewriter : CSharpSyntaxRewriter
{
    private static SyntaxTriviaList CreateComment(
        string comment)
    {
        return SyntaxFactory.ParseLeadingTrivia(
            $"// {comment}{Environment.NewLine}");
    }

    private static bool HasComment(
        SyntaxNode node)
    {
        return node.GetLeadingTrivia()
            .Any(t =>
                t.IsKind(SyntaxKind.SingleLineCommentTrivia));
    }

    public override SyntaxNode? VisitIfStatement(
        IfStatementSyntax node)
    {
        node = (IfStatementSyntax)
            base.VisitIfStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Check condition")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitForStatement(
        ForStatementSyntax node)
    {
        node = (ForStatementSyntax)
            base.VisitForStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Iterate using for loop")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitForEachStatement(
        ForEachStatementSyntax node)
    {
        node = (ForEachStatementSyntax)
            base.VisitForEachStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Iterate through collection")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitWhileStatement(
        WhileStatementSyntax node)
    {
        node = (WhileStatementSyntax)
            base.VisitWhileStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Execute while condition is true")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitSwitchStatement(
        SwitchStatementSyntax node)
    {
        node = (SwitchStatementSyntax)
            base.VisitSwitchStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Evaluate switch expression")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitTryStatement(
        TryStatementSyntax node)
    {
        node = (TryStatementSyntax)
            base.VisitTryStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Execute protected operation")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitReturnStatement(
        ReturnStatementSyntax node)
    {
        node = (ReturnStatementSyntax)
            base.VisitReturnStatement(node)!;

        if (HasComment(node))
            return node;

        return node.WithLeadingTrivia(
            CreateComment("Return result")
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitLocalDeclarationStatement(
        LocalDeclarationStatementSyntax node)
    {
        node = (LocalDeclarationStatementSyntax)
            base.VisitLocalDeclarationStatement(node)!;

        if (HasComment(node))
            return node;

        string? comment =
            PatternCommentGenerator
                .Generate(node);

        if (string.IsNullOrWhiteSpace(comment))
            return node;

        return node.WithLeadingTrivia(
            CreateComment(comment)
            .AddRange(node.GetLeadingTrivia()));
    }

    public override SyntaxNode? VisitExpressionStatement(
        ExpressionStatementSyntax node)
    {
        node = (ExpressionStatementSyntax)
            base.VisitExpressionStatement(node)!;

        if (HasComment(node))
            return node;

        string? comment =
            PatternCommentGenerator
                .Generate(node);

        if (string.IsNullOrWhiteSpace(comment))
            return node;

        return node.WithLeadingTrivia(
            CreateComment(comment)
            .AddRange(node.GetLeadingTrivia()));
    }
}