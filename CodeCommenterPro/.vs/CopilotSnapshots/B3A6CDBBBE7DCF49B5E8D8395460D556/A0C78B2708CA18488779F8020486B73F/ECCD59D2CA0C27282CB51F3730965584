using CodeCommenterPro.Configuration;
using CodeCommenterPro.Roslyn;
using Microsoft.CodeAnalysis.CSharp;

namespace CodeCommenterPro.Services;

public class FileScanner
{
    private readonly Settings _settings;

    public FileScanner(Settings settings)
    {
        _settings = settings;
    }

    public void ProcessFile(
        string file)
    {
        if (_settings.CreateBackups)
        {
            new BackupService()
                .CreateBackup(file);
        }

        string source =
            File.ReadAllText(file);

        var tree =
            CSharpSyntaxTree.ParseText(source);

        var root = tree.GetRoot();

        var generator =
            new CommentGenerator();

        var rewriter =
            new DocumentationRewriter(generator);

        var newRoot =
            rewriter.Visit(root);

        File.WriteAllText(
            file,
            newRoot!.ToFullString());
    }
}