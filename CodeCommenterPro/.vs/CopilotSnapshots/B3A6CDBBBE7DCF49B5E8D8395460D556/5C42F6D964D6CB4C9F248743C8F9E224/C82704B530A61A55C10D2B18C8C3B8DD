namespace CodeCommenterPro.Roslyn;

using CodeCommenterPro.Helpers;
using Microsoft.CodeAnalysis;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using System.Text;

public class CommentGenerator
{
    public string GenerateClassComment(
        string className)
    {
                return
        $@"/// <summary>
        /// Represents {NamingHelper.SplitCamelCase(className)}.
        /// </summary>";
    }

    public string GeneratePropertyComment(
        string propertyName)
    {
                return
        $@"/// <summary>
        /// Gets or sets {NamingHelper.SplitCamelCase(propertyName)}.
        /// </summary>";
    }

    public string GenerateConstructorComment(
        ConstructorDeclarationSyntax ctor)
    {
        var sb = new StringBuilder();

        sb.AppendLine("/// <summary>");
        sb.AppendLine(
            $"/// Initializes a new instance of {ctor.Identifier.Text}.");
        sb.AppendLine("/// </summary>");

        foreach (var parameter in ctor.ParameterList.Parameters)
        {
            sb.AppendLine(
                $"/// <param name=\"{parameter.Identifier.Text}\">" +
                $"{NamingHelper.SplitCamelCase(parameter.Identifier.Text)}." +
                "</param>");
        }

        return sb.ToString();
    }

    public string GenerateConstructorComment(
        ConstructorDeclarationSyntax ctor,
        Microsoft.CodeAnalysis.SemanticModel? semanticModel = null)
    {
        var sb = new StringBuilder();

        sb.AppendLine("/// <summary>");
        sb.AppendLine(
            $"/// Initializes a new instance of {ctor.Identifier.Text}.");
        sb.AppendLine("/// </summary>");

        foreach (var parameter in ctor.ParameterList.Parameters)
        {
            sb.AppendLine(
                $"/// <param name=\"{parameter.Identifier.Text}\">" +
                $"{NamingHelper.SplitCamelCase(parameter.Identifier.Text)}." +
                "</param>");
        }

        if (semanticModel != null)
        {
            try
            {
                var analyzer = new SemanticBusinessAnalyzer(semanticModel);
                var findings = analyzer.AnalyzeConstructor(ctor);
                foreach (var f in findings)
                {
                    sb.AppendLine("/// <remarks>");
                    sb.AppendLine($"/// {f}.");
                    sb.AppendLine("/// </remarks>");
                }

                try
                {
                    var rules = BusinessRuleAnalyzer.AnalyzeSemantic(ctor, semanticModel);
                    foreach (var r in rules)
                    {
                        sb.AppendLine("/// <remarks>");
                        sb.AppendLine($"/// {r}.");
                        sb.AppendLine("/// </remarks>");
                    }
                }
                catch
                {
                }
            }
            catch
            {
            }
        }

        return sb.ToString();
    }

    public string GenerateMethodComment(
        MethodDeclarationSyntax method,
        SemanticModel? semanticModel = null)
    {
        var sb = new StringBuilder();

        string methodName =
            NamingHelper.SplitCamelCase(
                method.Identifier.Text);

        sb.AppendLine("/// <summary>");

        if (method.Identifier.Text.EndsWith("Async"))
        {
            sb.AppendLine(
                $"/// Performs {methodName} asynchronously.");
        }
        else
        {
            sb.AppendLine(
                $"/// Performs {methodName}.");
        }

        sb.AppendLine("/// </summary>");

        foreach (var parameter in method.ParameterList.Parameters)
        {
            sb.AppendLine(
                $"/// <param name=\"{parameter.Identifier.Text}\">" +
                $"{NamingHelper.SplitCamelCase(parameter.Identifier.Text)}." +
                "</param>");
        }

        // Include return description if not void
        if (method.ReturnType.ToString() != "void")
        {
            sb.AppendLine(
                $"/// <returns>{method.ReturnType}</returns>");
        }

        // Try to append pattern-based descriptions and business rules when available.
        try
        {
            var pattern = PatternCommentGenerator.Generate(method, semanticModel);
            if (!string.IsNullOrWhiteSpace(pattern))
            {
                sb.AppendLine("/// <remarks>");
                sb.AppendLine($"/// {pattern}.");
                sb.AppendLine("/// </remarks>");
            }

            // Consult business rules from RuleLoader
            var rules = CodeCommenterPro.Helpers.RuleLoader.Load();
            var text = method.ToString();
            foreach (var br in rules.BusinessRules)
            {
                if (string.IsNullOrWhiteSpace(br.Match))
                    continue;

                if (System.Text.RegularExpressions.Regex.IsMatch(text, br.Match))
                {
                    sb.AppendLine("/// <remarks>");
                    sb.AppendLine($"/// Business rule: {br.Description}.");
                    sb.AppendLine("/// </remarks>");
                }
            }

            if (semanticModel != null)
            {
                // Semantic analyzer findings
                var analyzer = new SemanticBusinessAnalyzer(semanticModel);
                var findings = analyzer.AnalyzeMethod(method);
                foreach (var f in findings)
                {
                    sb.AppendLine("/// <remarks>");
                    sb.AppendLine($"/// {f}.");
                    sb.AppendLine("/// </remarks>");
                }

                // Business rule analyzer using semantic model
                try
                {
                    var rules = BusinessRuleAnalyzer.AnalyzeSemantic(method, semanticModel);
                    foreach (var r in rules)
                    {
                        sb.AppendLine("/// <remarks>");
                        sb.AppendLine($"/// {r}.");
                        sb.AppendLine("/// </remarks>");
                    }
                }
                catch
                {
                }
            }
        }
        catch
        {
            // Keep generation resilient; ignore analyzer failures
        }

        return sb.ToString();
    }
}