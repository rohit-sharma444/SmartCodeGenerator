namespace CodeCommenterPro.Roslyn;

using CodeCommenterPro.Helpers;
using Microsoft.CodeAnalysis.CSharp.Syntax;
using System.Text;

public class CommentGenerator
{
    public string GenerateClassComment(
        string className)
    {
                return
        $@"/// <summary>
        /// Represents {NamingHelper.SplitCamelCase(className)}.
        /// </summary>";
    }

    public string GeneratePropertyComment(
        string propertyName)
    {
                return
        $@"/// <summary>
        /// Gets or sets {NamingHelper.SplitCamelCase(propertyName)}.
        /// </summary>";
    }

    public string GenerateConstructorComment(
        ConstructorDeclarationSyntax ctor)
    {
        var sb = new StringBuilder();

        sb.AppendLine("/// <summary>");
        sb.AppendLine(
            $"/// Initializes a new instance of {ctor.Identifier.Text}.");
        sb.AppendLine("/// </summary>");

        foreach (var parameter in ctor.ParameterList.Parameters)
        {
            sb.AppendLine(
                $"/// <param name=\"{parameter.Identifier.Text}\">" +
                $"{NamingHelper.SplitCamelCase(parameter.Identifier.Text)}." +
                "</param>");
        }

        return sb.ToString();
    }

    public string GenerateMethodComment(
        MethodDeclarationSyntax method)
    {
        var sb = new StringBuilder();

        string methodName =
            NamingHelper.SplitCamelCase(
                method.Identifier.Text);

        sb.AppendLine("/// <summary>");

        if (method.Identifier.Text.EndsWith("Async"))
        {
            sb.AppendLine(
                $"/// Performs {methodName} asynchronously.");
        }
        else
        {
            sb.AppendLine(
                $"/// Performs {methodName}.");
        }

        sb.AppendLine("/// </summary>");

        foreach (var parameter in method.ParameterList.Parameters)
        {
            sb.AppendLine(
                $"/// <param name=\"{parameter.Identifier.Text}\">" +
                $"{NamingHelper.SplitCamelCase(parameter.Identifier.Text)}." +
                "</param>");
        }

        if (method.ReturnType.ToString() != "void")
        {
            sb.AppendLine(
                $"/// <returns>{method.ReturnType}</returns>");
        }

        return sb.ToString();
    }
}