namespace CodeCommenterPro.Services;

using CodeCommenterPro.Configuration;
using CodeCommenterPro.Models;
using System.Collections.Concurrent;

public class SolutionScanner
{
    private readonly Settings _settings;

    public SolutionScanner(Settings settings)
    {
        _settings = settings;
    }

    public CoverageReport Process(
        string rootFolder)
    {
        if (!Directory.Exists(rootFolder))
        {
            throw new DirectoryNotFoundException(
                rootFolder);
        }

        var report = new CoverageReport();

        string[] files =
            Directory.GetFiles(
                rootFolder,
                "*.cs",
                SearchOption.AllDirectories);

        files = files
            .Where(f => !IgnoreService.ShouldSkip(f))
            .ToArray();

        report.TotalFiles = files.Length;

        var statistics =
            new List<FileStatistics>();

        int totalFiles = files.Length;
        int current = 0;

        foreach (string file in files)
        {
            try
            {
                current++;

                Console.WriteLine(
                    $"[{current}/{totalFiles}] {file}");

                var scanner =
                    new FileScanner(_settings);

                var result =
                    scanner.ProcessFile(file);

                statistics.Add(result);

                Console.WriteLine(
                    $"Processed: {file}");
            }
            catch (Exception ex)
            {
                Console.WriteLine(
                    $"ERROR: {file}");

                Console.WriteLine(
                    ex.Message);
            }
        }

        foreach (var stat in statistics)
        {
            report.TotalClasses += stat.Classes;

            report.TotalMethods += stat.Methods;

            report.TotalProperties += stat.Properties;

            report.TotalConstructors +=
                stat.Constructors;

            report.DocumentedClasses +=
                stat.DocumentedClasses;

            report.DocumentedMethods +=
                stat.DocumentedMethods;

            report.DocumentedProperties +=
                stat.DocumentedProperties;

            report.DocumentedConstructors +=
                stat.DocumentedConstructors;
        }

        if (_settings.GenerateHtmlReport)
        {
            string reportFile =
                Path.Combine(
                    rootFolder,
                    "CodeCommenterReport.html");

            var html =
                new HtmlReportService();

            html.Generate(
                report,
                reportFile);
        }

        return report;
    }
}