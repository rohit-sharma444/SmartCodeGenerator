using CodeGenerator.Models;
using System.Text;
using System.Linq;

namespace CodeGenerator.Services;

public class CodeGenerator
{
    public string Generate(ParsedCommand command)
    {
        return command.Intent switch
        {
            IntentType.CreateClass => GenerateClass(command),
            _ => "// Unsupported command"
        };
    }

    private static string GenerateClass(ParsedCommand command)
    {
        ArgumentNullException.ThrowIfNull(command);

        var sb = new StringBuilder();

        var typeInferer = new TypeInferer(DefaultTypeRules.Create());

        sb.AppendLine($"public class {ToPascalCase(command.ClassName)}");
        sb.AppendLine("{");

        foreach (var property in command.Properties)
        {
            var propertyName = ToPascalCase(property.Name);
            var propertyType = ResolvePropertyType(property, typeInferer);
            sb.AppendLine($"    public {propertyType} {propertyName} {{ get; set; }}");
        }

        // Methods
        if (command.Methods != null && command.Methods.Any())
        {
            sb.AppendLine();
            foreach (var method in command.Methods)
            {
                var methodName = ToPascalCase(method.Name);
                var returnTypeRaw = string.IsNullOrWhiteSpace(method.ReturnType) ? "void" : method.ReturnType;
                var returnType = NormalizeType(returnTypeRaw);
                if (string.Equals(returnType, "void", StringComparison.OrdinalIgnoreCase))
                {
                    sb.AppendLine($"    public {returnType} {methodName}() {{ }}");
                }
                else
                {
                    sb.AppendLine($"    public {returnType} {methodName}() {{ return default; }}");
                }
            }
        }

        sb.AppendLine("}");

        return sb.ToString();
    }

    private static string ResolvePropertyType(
        PropertyDefinition property,
        TypeInferer typeInferer)
    {
        Console.WriteLine($"[CodeGenerator] Resolving type for property '{property.Name}' (raw='{property.Type}')");

        if (!string.IsNullOrWhiteSpace(property.Type))
        {
            var normalized = NormalizeType(property.Type);
            Console.WriteLine($"[CodeGenerator] Using explicit type '{property.Type}' -> '{normalized}'");
            return normalized;
        }

        var inferred = typeInferer.InferType(property.Name);
        Console.WriteLine($"[CodeGenerator] TypeInferer inferred '{inferred}' for name '{property.Name}'");

        if (string.IsNullOrWhiteSpace(inferred))
        {
            inferred = InferTypeFromName(property.Name);
            Console.WriteLine($"[CodeGenerator] Heuristic inferred '{inferred}' for name '{property.Name}'");
        }

        var final = NormalizeType(inferred);
        Console.WriteLine($"[CodeGenerator] Final normalized type for '{property.Name}' is '{final}'");
        return final;
    }


    private static string NormalizeType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
            return "string";

        return type.Trim().ToLowerInvariant() switch
        {
            "int" or "integer" or "int32" => "int",
            "long" or "int64" or "bigint" => "long",
            "string" or "text" or "varchar" or "nvarchar" => "string",
            "bool" or "boolean" => "bool",
            "decimal" or "money" or "currency" => "decimal",
            "double" => "double",
            "float" => "float",
            "datetime" or "date" or "timestamp" => "System.DateTime",
            "datetimeoffset" or "timestamptz" => "System.DateTimeOffset",
            "guid" or "uuid" or "uid" or "uniqueidentifier" => "System.Guid",
            "byte" => "byte",
            "short" or "int16" => "short",
            "char" => "char",
            "object" => "object",
            _ => type,
        };
    }


    private static IEnumerable<string> KnownTypes()
    {
        return new[] { "int", "string", "bool", "datetime", "guid", "double", "decimal", "float", "long", "byte", "short", "char", "object" };
    }

    private static string InferTypeFromName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "string";

        var n = name.Trim().ToLowerInvariant();
        if ((n.EndsWith("id") && n != "id") || n.EndsWith("_id"))
            return "int";
        if (n.EndsWith("guid") || n.EndsWith("uuid") || n.Contains("uid"))
            return "Guid";
        if (n.StartsWith("is") || n.StartsWith("has") || n.StartsWith("can") || n.StartsWith("should") || n.StartsWith("was"))
            return "bool";
        if (n.EndsWith("date") || n.EndsWith("at") || n.EndsWith("time") || n.EndsWith("_at") || n.Contains("timestamp"))
            return "DateTime";
        if (n.EndsWith("count") || n.EndsWith("number") || n.EndsWith("qty") || n.EndsWith("quantity") || n.EndsWith("age") || n.Contains("count"))
            return "int";
        if (n.EndsWith("amount") || n.EndsWith("price") || n.EndsWith("total") || n.Contains("cost"))
            return "decimal";

        return "string";
    }

    private static string ToPascalCase(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return name;

        var parts = name.Split(new[] { '_', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => char.ToUpperInvariant(p[0]) + (p.Length > 1 ? p.Substring(1) : "")));
    }
}