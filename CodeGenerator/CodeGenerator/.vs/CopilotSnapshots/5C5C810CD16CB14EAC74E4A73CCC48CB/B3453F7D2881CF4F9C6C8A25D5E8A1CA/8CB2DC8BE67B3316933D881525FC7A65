using CodeGenerator.Models;
using System.Text;
using System.Linq;

namespace CodeGenerator.Services;

public class CodeGenerator
{
    public string Generate(
        ParsedCommand command)
    {
        return command.Intent switch
        {
            IntentType.CreateClass =>
                GenerateClass(command),

            _ => "// Unsupported command"
        };
    }

    private string GenerateClass(ParsedCommand command)
    {
        var sb = new StringBuilder();

        sb.AppendLine($"public class {command.ClassName}");

        sb.AppendLine("{");

        foreach (var property in command.Properties)
            sb.AppendLine($"    public {property.Type} {property.Name} {{ get; set; }}");

        sb.AppendLine("}");

        return sb.ToString();
    }

    private static (string Name, string Type) ParseProperty(string input)
    {
        if (string.IsNullOrWhiteSpace(input))
            return ("Property", "string");

        var text = input.Trim();

        // Support formats: "Name:Type", "Type Name", "Name Type", "Name"
        // Try colon form first
        if (text.Contains(':'))
        {
            var parts = text.Split(new[] { ':' }, 2);
            var name = parts[0].Trim();
            var type = parts[1].Trim();
            return (ToPascalCase(name), NormalizeType(type));
        }

        var tokens = text.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        // If two tokens, determine which is type based on known CLR/C# types
        if (tokens.Length == 2)
        {
            var known = KnownTypes();
            if (known.Contains(tokens[0], StringComparer.OrdinalIgnoreCase))
            {
                return (ToPascalCase(tokens[1]), NormalizeType(tokens[0]));
            }
            if (known.Contains(tokens[1], StringComparer.OrdinalIgnoreCase))
            {
                return (ToPascalCase(tokens[0]), NormalizeType(tokens[1]));
            }
            // default: treat second as type
            return (ToPascalCase(tokens[0]), NormalizeType(tokens[1]));
        }

        // If single token, just a name
        if (tokens.Length == 1)
            return (ToPascalCase(tokens[0]), "string");

        // Fallback: try to find the token "type" or "of" patterns
        var idx = Array.FindIndex(tokens, t => t.Equals("type", StringComparison.OrdinalIgnoreCase));
        if (idx >= 0 && idx < tokens.Length - 1)
            return (ToPascalCase(tokens[0]), NormalizeType(tokens[idx + 1]));

        // Last resort
        return (ToPascalCase(tokens[0]), "string");
    }

    private static string NormalizeType(string type)
    {
        if (string.IsNullOrWhiteSpace(type))
            return "string";

        type = type.Trim();

        // Map common aliases to C# keywords
        return type.ToLower() switch
        {
            "int32" => "int",
            "int64" => "long",
            "integer" => "int",
            "string" => "string",
            "bool" => "bool",
            "boolean" => "bool",
            "datetime" => "System.DateTime",
            "guid" => "System.Guid",
            "double" => "double",
            "decimal" => "decimal",
            "float" => "float",
            _ => type
        };
    }

    private static IEnumerable<string> KnownTypes()
    {
        return new[] { "int", "string", "bool", "datetime", "guid", "double", "decimal", "float", "long", "byte", "short", "char", "object" };
    }

    private static string ToPascalCase(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return name;

        var parts = name.Split(new[] { '_', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => char.ToUpperInvariant(p[0]) + (p.Length > 1 ? p.Substring(1) : "")));
    }
}