using CodeGenerator.Models;
using System.Text.RegularExpressions;

namespace CodeGenerator.Services;

public class EntityExtractor
{
    public ParsedCommand Extract(
        string sentence,
        IntentType intent)
    {
        var result = new ParsedCommand
        {
            Intent = intent
        };

        if (intent == IntentType.CreateClass)
        {
            ExtractClassInfo(sentence, result);
        }

        return result;
    }

    private void ExtractClassInfo(
        string sentence,
        ParsedCommand command)
    {
        var match =
            Regex.Match(
                sentence,
                @"class\s+(\w+)",
                RegexOptions.IgnoreCase);

        if (match.Success)
        {
            command.ClassName =
                match.Groups[1].Value;
        }

        var propMatch =
            Regex.Match(
                sentence,
                @"properties\s+(.+)",
                RegexOptions.IgnoreCase);

        if (propMatch.Success)
        {
            var properties =
                propMatch.Groups[1]
                    .Value
                    .Replace("and", ",");

            command.Properties =
                [.. properties
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(x => x.Trim())];
        }
    }
}