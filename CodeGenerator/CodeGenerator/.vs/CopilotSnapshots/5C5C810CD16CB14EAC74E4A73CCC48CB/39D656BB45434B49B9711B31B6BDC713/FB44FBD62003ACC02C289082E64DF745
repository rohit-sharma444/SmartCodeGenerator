using CodeGenerator.Models;
using System.Text;
using System.Linq;

namespace CodeGenerator.Services;

public class CodeGenerator
{
    public string Generate(
        ParsedCommand command)
    {
        return command.Intent switch
        {
            IntentType.CreateClass =>
                GenerateClass(command),

            _ => "// Unsupported command"
        };
    }

    private static string GenerateClass(ParsedCommand command)
    {
        ArgumentNullException.ThrowIfNull(command);

        var sb = new StringBuilder();

        var typeInferer = new TypeInferer(DefaultTypeRules.Create());

        sb.AppendLine($"public class {ToPascalCase(command.ClassName)}");
        sb.AppendLine("{");

        foreach (var property in command.Properties)
        {
            var propertyName = ToPascalCase(property.Name);
            var propertyType = ResolvePropertyType(property, typeInferer);
            sb.AppendLine($"    public {propertyType} {propertyName} {{ get; set; }}");
        }

        sb.AppendLine("}");

        return sb.ToString();
    }

    private static string ResolvePropertyType(
        PropertyDefinition property,
        TypeInferer typeInferer)
    {
        if (!string.IsNullOrWhiteSpace(property.Type))
            return NormalizeType(property.Type);

        return typeInferer.InferType(property.Name);
    }


    private static string NormalizeType(string type)
    {
        return type.Trim().ToLower() switch
        {
            "int" or "integer" => "int",
            "string" or "text" or "varchar" => "string",
            "bool" or "boolean" => "bool",
            "decimal" or "money" or "currency" => "decimal",
            "double" => "double",
            "float" => "float",
            "datetime" or "date" => "DateTime",
            "guid" or "uniqueidentifier" => "Guid",
            _ => type,
        };
    }


    private static IEnumerable<string> KnownTypes()
    {
        return new[] { "int", "string", "bool", "datetime", "guid", "double", "decimal", "float", "long", "byte", "short", "char", "object" };
    }

    private static string ToPascalCase(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return name;

        var parts = name.Split(new[] { '_', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => char.ToUpperInvariant(p[0]) + (p.Length > 1 ? p.Substring(1) : "")));
    }
}