using CodeGenerator.Models;
using CodeGenerator.Services;
using Microsoft.CodeAnalysis;
using System.Reflection;
using System;
using System.IO;
using System.Linq;
using System.Collections.Generic;
using System.Text.Json;
using System.Xml.Linq;


var engine = new NaturalLanguageCodeEngine();
var roslyn = new RoslynClassGenerator();
var intentAnalyzer = new IntentAnalyzer();
var extractor = new EntityExtractor();

var factory = new DotNetProjectFactory();
var project = factory.CreateProject(
        new ProjectRequest
        {
            ProjectName = "Employee",
            OutputFolder = @"D:\Projects",
            ProjectType = DotNetProjectType.Console
        });

Console.WriteLine(project.Message);

// Try to load property validation rules from rules.json in the current directory
var configuredRules = new List<PropertyRule>();
var rulesPath = Path.Combine(Directory.GetCurrentDirectory(), "rules.json");
if (File.Exists(rulesPath))
{
    try
    {
        var json = File.ReadAllText(rulesPath);
        var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        var loaded = JsonSerializer.Deserialize<List<PropertyRule>>(json, opts);
        if (loaded != null)
            configuredRules = loaded;

        Console.WriteLine($"Loaded {configuredRules.Count} property rules from rules.json");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Failed to load rules.json: {ex.Message}");
    }
}

Console.WriteLine("CodeGenerator - enter natural language instructions (e.g. 'create class Customer with properties Id and Name')");
Console.WriteLine("Type 'demo' for a sample class, or 'exit' to quit.");

// helper to find nearest csproj by walking up directories
string? FindNearestProjectFile(string startDir)
{
    var dir = new DirectoryInfo(startDir);
    while (dir != null)
    {
        var csproj = dir.GetFiles("*.csproj").FirstOrDefault();
        if (csproj != null)
            return csproj.FullName;

        dir = dir.Parent;
    }

    return null;
}

while (true)
{
    Console.Write(" > ");
    var input = Console.ReadLine();

    if (string.IsNullOrWhiteSpace(input))
        continue;

    if (input.Equals("exit", StringComparison.OrdinalIgnoreCase))
        break;

    string code;
    ParsedCommand? parsed = null;

    if (input.Equals("demo", StringComparison.OrdinalIgnoreCase))
    {
        var customer = new ClassDefinition
        {
            Name = "Customer",
            Properties =
            {
                new() { Name = "Id", Type = "int" },
                new() { Name = "Name", Type = "string" },
                new() { Name = "Email", Type = "string" }
            },
            Methods =
            {
                new() { Name = "Save", ReturnType = "void" },
                new() { Name = "Validate", ReturnType = "bool" }
            }
        };

        code = roslyn.Generate(customer);

        // Build a parsed command for rule validation and later file naming
        var demoCommand = new ParsedCommand
        {
            Intent = IntentType.CreateClass,
            ClassName = customer.Name,
            Properties = customer.Properties,
            Methods = customer.Methods
        };
        parsed = demoCommand;

        var demoIssues = PropertyRulesEngine.ValidateProperties(demoCommand.Properties, configuredRules.Any() ? configuredRules : new List<PropertyRule>
        {
            new() { PropertyName = "Id", ExpectedType = "int", IsRequired = true, IsUnique = true },
            new() { PropertyName = "Email", ExpectedType = "string", IsRequired = true }
        });
        if (demoIssues.Any())
        {
            Console.WriteLine("\n--- Property Rule Violations (demo) ---");
            foreach (var issue in demoIssues)
                Console.WriteLine("  " + issue);
        }
    }
    else
    {
        code = engine.GenerateCode(input);

        // Extract parsed command and validate rules if this looks like a create class intent
        var intent = intentAnalyzer.Detect(input);
        parsed = extractor.Extract(input, intent);

        if (parsed != null && parsed.Intent == IntentType.CreateClass)
        {
            // Example rules - adapt as needed
            var issues = PropertyRulesEngine.ValidateProperties(parsed.Properties, configuredRules.Any() ? configuredRules : new List<PropertyRule>
            {
                new() { PropertyName = "Id", ExpectedType = "int", IsRequired = true, IsUnique = true },
                new() { PropertyName = "Email", ExpectedType = "string" }
            });
            if (issues.Any())
            {
                Console.WriteLine("\n--- Property Rule Violations ---");
                foreach (var issue in issues)
                    Console.WriteLine("  " + issue);
            }
        }
    }

    Console.WriteLine("\n--- Generated Code ---\n");
    Console.WriteLine(code);

    // Save generated class to project 'Generated' folder inside nearest .csproj
    try
    {
        var className = parsed?.ClassName ?? (input.Equals("demo", StringComparison.OrdinalIgnoreCase) ? "Customer" : null);
        // Try to infer class name from code if still null
        if (string.IsNullOrWhiteSpace(className))
        {
            var m = System.Text.RegularExpressions.Regex.Match(code ?? string.Empty, @"class\s+(\w+)");
            if (m.Success)
                className = m.Groups[1].Value;
        }

        if (!string.IsNullOrWhiteSpace(className))
        {
            // find nearest project file and place generated code under its folder
            var startDir = Directory.GetCurrentDirectory();
            var csproj = FindNearestProjectFile(startDir);
            string genDir;
            if (!string.IsNullOrWhiteSpace(csproj))
            {
                var projDir = Path.GetDirectoryName(csproj)!;
                genDir = Path.Combine(projDir, "Generated");
            }
            else
            {
                genDir = Path.Combine(Directory.GetCurrentDirectory(), "Generated");
            }

            Directory.CreateDirectory(genDir);

            var fileCode = code;
            if (!code.Contains("namespace "))
            {
                // Wrap in namespace to keep project organized
                fileCode = $"namespace GeneratedCode\n{{\n{code}\n}}";
            }

            var filePath = Path.Combine(genDir, className + ".cs");
            File.WriteAllText(filePath, fileCode);
            Console.WriteLine($"Saved generated class to: {filePath}");

            // If a project file was found, ensure it's included in the csproj
            if (!string.IsNullOrWhiteSpace(csproj))
            {
                try
                {
                    var doc = System.Xml.Linq.XDocument.Load(csproj);
                    var ns = doc.Root?.GetDefaultNamespace();
                    var relative = Path.GetRelativePath(Path.GetDirectoryName(csproj)!, filePath).Replace('\\', '/');

                    var hasCompile = doc.Descendants("Compile").Any(x => x.Attribute("Include")?.Value == relative);
                    if (!hasCompile)
                    {
                        var itemGroup = doc.Root.Elements("ItemGroup").FirstOrDefault() ?? new System.Xml.Linq.XElement(doc.Root.GetDefaultNamespace() + "ItemGroup");
                        itemGroup.Add(new System.Xml.Linq.XElement(doc.Root.GetDefaultNamespace() + "Compile", new System.Xml.Linq.XAttribute("Include", relative)));
                        if (!doc.Root.Elements("ItemGroup").Any())
                            doc.Root.Add(itemGroup);

                        doc.Save(csproj);
                        Console.WriteLine($"Updated project file to include: {relative}");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to update project file: {ex.Message}");
                }
            }
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Failed to save generated file: {ex.Message}");
    }

    Console.WriteLine("\n--- Semantic Validation ---\n");
    var semantic = SemanticValidator.Validate(code);

    if (!semantic.IsValid)
    {
        Console.WriteLine("Errors:");
        foreach (var e in semantic.Errors)
            Console.WriteLine("  " + e);
    }

    if (semantic.Warnings.Any())
    {
        Console.WriteLine("Warnings:");
        foreach (var w in semantic.Warnings)
            Console.WriteLine("  " + w);
    }

    if (semantic.Information.Any())
    {
        Console.WriteLine("Info:");
        foreach (var i in semantic.Information)
            Console.WriteLine("  " + i);
    }

    Console.WriteLine("\n--- Compilation ---\n");
    var result = Compiler.Compile(code);

    if (!result.Success)
    {
        Console.WriteLine("Compilation failed. Diagnostics:");
        foreach (var d in result.Diagnostics)
            Console.WriteLine("  " + d);
        continue;
    }

    Console.WriteLine("Compilation succeeded. Types in assembly:");
    var assembly = Assembly.Load(result.AssemblyBytes);
    foreach (var type in assembly.GetTypes())
    {
        Console.WriteLine("- " + type.FullName);
        var props = type.GetProperties(BindingFlags.Public | BindingFlags.Instance);
        if (props.Any())
        {
            Console.WriteLine("  Properties:");
            foreach (var p in props)
                Console.WriteLine($"    {p.PropertyType.Name} {p.Name}");
        }

        var methods = type.GetMethods(BindingFlags.Public | BindingFlags.Instance | BindingFlags.DeclaredOnly);
        if (methods.Any())
        {
            Console.WriteLine("  Methods:");
            foreach (var m in methods)
                Console.WriteLine($"    {m.ReturnType.Name} {m.Name}()");
        }
    }

    Console.WriteLine();
}
