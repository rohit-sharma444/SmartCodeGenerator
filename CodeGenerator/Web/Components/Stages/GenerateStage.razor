@using AppScaffolding
@using AppScaffolding.Targets
@using CodeGenerationEngine.Models
@using CodeGenerator.App
@using CodeGenerationEngine.Helper
@using CodeGenerator.BuildFix
@using CodeGenerator.Web.Workflow
@implements IDisposable
@inject IServiceProvider Services

@if (_phase == Phase.Confirm)
{
    <p>Ready to write <strong>@_name</strong>.</p>

    <label>Name
        <input class="app-name answer" value="@_name" @onchange="NameTyped" />
    </label>

    @* Hidden rather than offered-and-refused: WPF and WinForms read JsonStore directly off the
       shared store seam, so SQLite is not a choice they have. *@
    @if (BuildAppCommand.IsPersistenceAllowed(Target, PersistenceKind.Sqlite))
    {
        <label>Persistence
            <select class="persistence answer" @onchange="PersistenceChosen">
                <option value="json">JSON</option>
                <option value="sqlite">SQLite</option>
            </select>
        </label>
    }

    @if (LayoutNotice is not null)
    {
        <p class="notice">@LayoutNotice</p>
    }

    <div class="actions">
        @* Writing is a real action rather than navigation, so it stays here and stays loud. *@
        <button type="button" class="write" @onclick="Write">Write it</button>
        <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
    </div>
}
else if (_phase == Phase.Overwrite)
{
    @* A question about losing work, so it is a decision rather than a default. *@
    <div class="overwrite" role="alertdialog">
        @foreach (var line in _collision)
        {
            <p>@line</p>
        }

        @* The console's [a]dd, offered only when there is something to add. *@
        @if (_newClasses > 0)
        {
            <button type="button" class="overwrite-add" @onclick="AddNew">
                Add the @_newClasses new @(_newClasses == 1 ? "class" : "classes")
            </button>
        }
        <button type="button" class="overwrite-yes" @onclick="Overwrite">Overwrite it</button>
        <button type="button" class="overwrite-rename" @onclick="() => _phase = Phase.Confirm">
            Use a different name
        </button>
        <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
    </div>
}
else
{
    @* Progress first, because during the minute this takes it is the only thing worth reading:
       scaffolding and a first build are both long enough that a still page reads as a hung one. *@
    <ProgressList Done="_steps" Current="@_step" Seconds="_seconds" />

    @foreach (var line in _report)
    {
        <p class="report-line">@line</p>
    }

    @* The build result is its own list, not part of _report, so that the rebuild after a fix can
       replace it: an old red result and a new green one on one page would contradict each other. *@
    @foreach (var line in _buildLines)
    {
        <p class="report-line">@line</p>
    }

    @if (_fixLines.Count > 0)
    {
        @* Text, never markup: these lines quote the compiler and the user's own file names. One
           line each, wrapped inside the box so a long path cannot widen the page. *@
        <pre class="fix-report">@string.Join("\n", _fixLines)</pre>
    }

    @if (_phase == Phase.Done && _failedBuild is not null && !_fixDeclined && !_fixing && Fixer is not null)
    {
        <div class="fix-offer">
            <p class="fix-question">@BuildFixReport.Title(_failedErrors)</p>
            @if (_fixerThrew)
            {
                <p class="fix-stale">The errors listed may be out of date, because files may have changed.</p>
            }
            <div class="actions">
                <button type="button" class="fix-yes" @onclick="FixErrors">@BuildFixReport.Options[0]</button>
                <button type="button" class="fix-no" @onclick="DeclineFix">@BuildFixReport.Options[1]</button>
            </div>
        </div>
    }

    @if (_log.Count > 0)
    {
        @* The compiler's own output, as it arrives. Scrolled to the end, so what is on screen is
           what the build is doing now rather than what it did first. *@
        <pre class="build-log">@string.Join(Environment.NewLine, _log)</pre>
    }

    @if (_phase == Phase.Done && !_written)
    {
        @* Nothing was written, so there is nothing for the run stage to do — this run ends here,
           and the console says why. *@
        <div class="actions">
            <button type="button" class="finish" @onclick="Finish">Done</button>
        </div>
    }
}

@code {
    private enum Phase { Confirm, Overwrite, Working, Done }

    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private Phase _phase = Phase.Confirm;

    /// <summary>What the overwrite question says about the app already there.</summary>
    private IReadOnlyList<string> _collision = [];

    /// <summary>How many of this model's classes the app already there does not have.</summary>
    private int _newClasses;
    private string _name = string.Empty;
    private PersistenceKind _persistence = PersistenceKind.Json;
    private readonly List<string> _report = [];

    /// <summary>The warnings about old-form validator stubs, which are in <see cref="_report"/> too.
    /// A green fix rewrote those stubs, so they are taken out then.</summary>
    private readonly HashSet<string> _stubWarnings = [];

    /// <summary>What the last build said; replaced when a fix rebuilds.</summary>
    private readonly List<string> _buildLines = [];

    /// <summary>Progress while the fixer runs, then its report.</summary>
    private readonly List<string> _fixLines = [];

    /// <summary>The red build the offer is about; null when there is nothing to offer a fix for.</summary>
    private ProcessResult? _failedBuild;
    private int _failedErrors;
    private bool _fixDeclined;

    /// <summary>True from the click until the fixer is done: a second click must not start a second fixer.</summary>
    private bool _fixing;

    // The fixer threw once: files may have changed, so the listed errors may be out of date.
    private bool _fixerThrew;

    private bool _disposed;
    private readonly List<string> _log = [];

    /// <summary>What has finished, and what is running — the progress the user watches.</summary>
    private readonly List<string> _steps = [];
    private string? _step;
    private int _seconds;
    private System.Timers.Timer? _clock;

    private ScaffoldResult? _scaffold;

    /// <summary>Whether a project reached disk. False keeps the workflow on this node, because a
    /// run stage with nothing to start is a dead end the user cannot act on.</summary>
    private bool _written;

    private ITargetScaffolder Target => Session.Target ?? TargetScaffolders.Default;

    /// <summary>Re-checked here rather than only at node 4, because the target can still be
    /// changed after the layout was named.</summary>
    private string? LayoutNotice => BuildAppCommand.LayoutNotice(Target, Session.Customization);

    protected override void OnInitialized()
    {
        _name = GenerateStep.NameFor(Session);

        // Withdrawn first, and that is not housekeeping: the step the review panel offered is
        // still there otherwise, so this box would show "Generate →" and taking it would walk on
        // to the run stage with nothing written. Nothing leads out of here until something has
        // been written.
        Navigation.Withdraw();

        // A reload — or a second tab — gets a new panel with empty fields, and offering to write
        // a project the session has already written would rebuild it behind the user's back. What
        // the session knows is authoritative; only the streamed build log is gone with the circuit
        // that watched it.
        if (Session.Generated is not { } app)
            return;

        _scaffold = app.Scaffold;
        _written = true;
        _phase = Phase.Done;

        _report.Add($"Generated project at {app.Scaffold.ProjectPath}");

        if (app.Scaffold.TestProjectPath is not null)
            _report.Add($"Generated test project at {app.Scaffold.TestProjectPath}");

        if (app.Scaffold.TestProjectProblem is { } testProblem)
            _report.Add(testProblem);

        // Repeated on a reload for the reason it was said at all: the kept stub is still on
        // disk and still unfixed, and the streamed build log that carried CS0759 went with
        // the circuit that watched it. A rebuilt panel that omits this is the one panel
        // whose user has nothing left to read the failure from.
        foreach (var stub in app.Scaffold.OutdatedValidatorStubs)
        {
            _report.Add(stub + ".");
            _stubWarnings.Add(stub + ".");
        }

        foreach (var unreadable in app.Scaffold.UnreadableSeedValues)
            _report.Add(unreadable + ".");

        foreach (var stale in app.Scaffold.StaleFiles)
            _report.Add(stale + ".");

        // Written already, so the way on is the box's, exactly as it is after a fresh write.
        Navigation.Offer(Continue);

        _steps.Add($"Wrote {app.Scaffold.FilesWritten.Count} file(s)");
        _steps.Add(app.BuildSucceeded ? "Compiled" : "The compiler reported problems");

        _report.Add(app.BuildSucceeded
            ? "It compiled."
            : "It did not compile. "
              + "A fix is offered only straight after a build, so it is not offered again on a reloaded page.");
    }

    /// <summary>A typed name goes through the typed-name rule, so what is written is always a
    /// usable identifier - and, being a name the user chose, is never shortened.</summary>
    private void NameTyped(ChangeEventArgs e)
        => _name = DomainAppName.FromTypedName(e.Value?.ToString() ?? _name);

    private void PersistenceChosen(ChangeEventArgs e)
        => _persistence = e.Value?.ToString() == "sqlite"
            ? PersistenceKind.Sqlite
            : PersistenceKind.Json;

    /// <summary>
    /// Starts the write, and is awaited.
    /// </summary>
    /// <remarks>
    /// Awaited rather than fire-and-forget: Blazor re-renders after an awaited handler completes,
    /// and a discarded task leaves the last state change — the one that says the build finished —
    /// with nothing to paint it. The panel then shows a build still running forever.
    /// </remarks>
    private async Task Write()
    {
        // A rename can collide too, so the question is asked about whatever name is current.
        if (GenerateStep.Collides(Session, _name, Target))
        {
            var delta = GenerateStep.DeltaFor(Session, _name, Target);

            _newClasses = AppScaffolding.Incremental.ModelDelta.NewNames(delta).Count;

            // The console's own wording, less its key hints: the page has buttons instead.
            _collision = OverwritePrompt
                .Warning(GenerateStep.FolderFor(Session, _name, Target), delta)
                .Where(line => line.Length > 0 && !line.TrimStart().StartsWith('['))
                .ToList();

            _phase = Phase.Overwrite;
            return;
        }

        await Go();
    }

    private async Task Overwrite() => await Go();

    private async Task AddNew() => await Go(addOnly: true);

    private async Task Go(bool addOnly = false)
    {
        _phase = Phase.Working;
        _report.Clear();
        _stubWarnings.Clear();
        _buildLines.Clear();
        _fixLines.Clear();
        _failedBuild = null;
        _fixerThrew = false;
        _fixDeclined = false;
        _log.Clear();
        _steps.Clear();

        Step($"Writing {_name} into {GenerateStep.FolderFor(Session, _name, Target)}");

        ScaffoldResult scaffold;

        if (addOnly)
        {
            var folder = GenerateStep.FolderFor(Session, _name, Target);
            var added = await Task.Run(
                () => GenerateStep.AddNew(Session, _name, Target, _persistence));

            // As a scaffold, so what follows - the build, the run stage - treats it like any
            // other write. The written files are only the added ones, which is what they are.
            scaffold = new ScaffoldResult(added.Success, folder, added.Written, added.Message)
            {
                OutdatedValidatorStubs = added.OutdatedValidatorStubs,
            };

            // Only on success: a failure is reported below, the same way a failed write is.
            if (added.Success)
                _report.AddRange(AddReport.Lines(added, folder).Where(line => line.Length > 0));
        }
        else
        {
            scaffold = await Task.Run(
                () => GenerateStep.Scaffold(Session, _name, Target, _persistence));
        }

        _scaffold = scaffold;

        // Said out loud: a row cap the user is not told about reads as "all your data is in there".
        foreach (var note in Session.ImportedData.Notes)
            _report.Add(note);

        if (!scaffold.Success)
        {
            Finished("Could not write the project");
            _report.Add($"Generation failed: {scaffold.Message}");
            _phase = Phase.Done;
            StateHasChanged();
            return;
        }

        Step("Compiling it — a first build restores packages and can take a minute",
             finished: $"Wrote {scaffold.FilesWritten.Count} file(s)");

        if (!addOnly)
            _report.Add($"Generated project at {scaffold.ProjectPath}");

        if (scaffold.TestProjectPath is not null)
            _report.Add($"Generated test project at {scaffold.TestProjectPath}");

        // A test project that could not be made is said, not left as an absence: every WPF and
        // WinForms app used to come out without one and without a word.
        if (scaffold.TestProjectProblem is { } testProblem)
            _report.Add(testProblem);

        // Before the compiler starts, because it is the reason the compiler is about to
        // fail: a .Custom.cs stub written before the validation pipeline is never
        // overwritten, so it survives a regenerate declaring a hook the regenerated half no
        // longer has. Said on the page and not only in the console sign-off, which arrives
        // after the whole workflow has finished — by then the user has already watched
        // CS0759 and CS8795 scroll past the build log with nothing naming the cause.
        // The add report has already listed them, under its own heading.
        if (!addOnly)
            foreach (var stub in scaffold.OutdatedValidatorStubs)
            {
                _report.Add(stub + ".");
                _stubWarnings.Add(stub + ".");
            }

        // The user's own values, missing from the app: said, not left for them to notice.
        foreach (var unreadable in scaffold.UnreadableSeedValues)
            _report.Add(unreadable + ".");

        // What the overwrite removed of an earlier generate's files for classes now gone.
        foreach (var stale in scaffold.StaleFiles)
            _report.Add(stale + ".");

        StateHasChanged();

        var runBuild = Runner;

        var built = await Task.Run(() => runBuild(
            scaffold.ProjectPath,
            line => InvokeAsync(() => { _log.Add(line); StateHasChanged(); })));

        // No compiler at all is not a failed build: the project is written, and saying "the
        // compiler reported problems" over an empty log would send the user looking for problems
        // that were never reported. The console front end has always said this here.
        if (built.Result is not { } result)
        {
            Finished("Could not start `dotnet` — the build was skipped");

            _report.Add(
                "Could not start `dotnet`, so the project was written but not compiled. "
                + "The steps below say how to build it yourself.");

            Session.SetGenerated(new GeneratedApp(
                scaffold,
                string.Join(Environment.NewLine, _log),
                BuildSucceeded: false,
                BuildRan: false,
                Persistence: _persistence));

            _written = true;
            _phase = Phase.Done;

            Navigation.Offer(Continue);
            StateHasChanged();

            return;
        }

        Finished(BuildReport.Succeeded(result)
            ? "Compiled"
            : "The compiler reported problems — the log is below");

        _buildLines.AddRange(BuildReport.Lines(result, built.Elapsed, scaffold.ProjectPath));
        SetFailedBuild(result, scaffold.ProjectPath);

        // Handed to the session, not kept here: the run stage starts what this stage wrote, and
        // it needs the build log to find the assembly.
        Session.SetGenerated(new GeneratedApp(
            scaffold,
            string.Join(Environment.NewLine, _log),
            BuildReport.Succeeded(result),
            Persistence: _persistence));

        _written = true;
        _phase = Phase.Done;

        // The run stage is now reachable, and the box says so.
        Navigation.Offer(Continue);

        // Belt as well as braces: the awaited handler re-renders on its own, but the same method
        // is reachable from the overwrite dialog and this is the transition that must not be lost.
        StateHasChanged();
    }

    /// <summary>
    /// Moves the progress list on: <paramref name="finished"/> is ticked off and
    /// <paramref name="next"/> becomes what is running.
    /// </summary>
    private void Step(string next, string? finished = null)
    {
        if (finished is not null)
            _steps.Add(finished);

        _step = next;
        _seconds = 0;

        StartClock();
        StateHasChanged();
    }

    /// <summary>Ticks the last step off and stops the clock — nothing is running any more.</summary>
    private void Finished(string last)
    {
        _steps.Add(last);
        _step = null;

        StopClock();
    }

    /// <remarks>
    /// A timer rather than a stopwatch read during renders: nothing else would cause a render
    /// while the scaffolder works, so without a tick of its own the elapsed time would sit at
    /// zero for the whole minute it is meant to be reassuring the user about.
    /// </remarks>
    private void StartClock()
    {
        if (_clock is not null)
            return;

        _clock = new System.Timers.Timer(1000) { AutoReset = true };

        _clock.Elapsed += async (_, _) =>
        {
            _seconds++;

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
            {
                // The circuit went away — a closed tab, mid-build. Nothing left to repaint.
                StopClock();
            }
        };

        _clock.Start();
    }

    private void StopClock()
    {
        _clock?.Stop();
        _clock?.Dispose();
        _clock = null;
    }

    public void Dispose()
    {
        _disposed = true;
        StopClock();
    }

    private BuildRunner Runner
        => Services.GetService(typeof(BuildRunner)) as BuildRunner ?? ((path, onLine) => GenerateStep.Build(path, onLine));

    private IBuildFixer? Fixer => Services.GetService(typeof(IBuildFixer)) as IBuildFixer;

    /// <summary>The offer exists only for a red build that ended, with errors the fixer can read.</summary>
    private void SetFailedBuild(ProcessResult build, string projectPath)
    {
        _failedBuild = null;
        _failedErrors = 0;
        _fixDeclined = false;

        if (!BuildAppCommand.ShouldOfferFix(build))
            return;

        var errors = BuildDiagnostics.Parse(build, projectPath).Count;

        if (errors == 0)
            return;

        _failedBuild = build;
        _failedErrors = errors;
    }

    private void DeclineFix() => _fixDeclined = true;

    /// <summary>Queues a change onto the renderer from the fixer's thread; never throws once the page is gone.</summary>
    private void Post(Action change)
    {
        if (_disposed)
            return;

        try
        {
            _ = InvokeAsync(() =>
            {
                if (_disposed)
                    return;

                change();
                StateHasChanged();
            }).ContinueWith(
                t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
            // The circuit went away; nothing left to repaint.
        }
    }

    /// <summary>
    /// Runs the fixer on a worker thread, then shows its report and the rebuilt result.
    /// </summary>
    /// <remarks>
    /// Awaited, for the reason <see cref="Write"/> gives. The fixer cannot be cancelled, so a page
    /// closed mid-run lets it finish: its edits are on disk, so the session is told the result either way.
    /// </remarks>
    private async Task FixErrors()
    {
        if (_fixing || _failedBuild is not { } failed || _scaffold is not { } scaffold || Fixer is not { } fixer)
            return;

        // One fixer per project across every page: two tabs would edit the same files at once.
        if (!FixLocks.TryEnter(scaffold.ProjectPath))
        {
            _fixLines.Clear();
            _fixLines.Add("A fix is already running for this project.");
            return;
        }

        // What the session wants NOW. The fix takes minutes; the user can change an earlier answer
        // meanwhile, and the app this fix repairs is then no longer the session's.
        var wanted = Session.Generated;

        TimeSpan elapsed = default;

        // Each finished rebuild with its own lines, because the run stage parses the build log to find
        // the assembly: only the log of the build the session ends up holding may be handed over.
        var rebuildLog = new List<string>();
        var rebuilds = new List<(ProcessResult Result, string Log)>();

        (FixOutcome?, Exception?) ran;

        // Everything after the lock is taken is inside the try, so no exit can leave it held.
        try
        {
            _fixing = true;
            _fixLines.Clear();
            _phase = Phase.Working;
            Navigation.Withdraw();
            Step("Fixing the build errors");
            _log.Add("--- fixing the build errors ---");
            StateHasChanged();

            var runBuild = Runner;
            var reread = _fixerThrew;

            ran = await Task.Run<(FixOutcome?, Exception?)>(() =>
            {
                try
                {
                    // After a throw the files may have changed, so the old errors may be wrong:
                    // read them again. An unusable fresh build leaves the old errors as they were.
                    var basis = failed;

                    if (reread)
                    {
                        var fresh = runBuild(scaffold.ProjectPath, line => Post(() => _log.Add(line))).Result;

                        if (fresh is not null && BuildAppCommand.ShouldOfferFix(fresh)
                            && BuildDiagnostics.Parse(fresh, scaffold.ProjectPath).Count > 0)
                            basis = fresh;
                    }

                    var result = fixer.Fix(
                        scaffold.ProjectPath,
                        basis,
                        () =>
                        {
                            lock (rebuildLog)
                                rebuildLog.Clear();

                            var attempt = runBuild(
                                scaffold.ProjectPath,
                                line =>
                                {
                                    lock (rebuildLog)
                                        rebuildLog.Add(line);

                                    Post(() => _log.Add(line));
                                });

                            elapsed = attempt.Elapsed;

                            if (attempt.Result is null)
                                throw new System.ComponentModel.Win32Exception();

                            lock (rebuildLog)
                                rebuilds.Add((attempt.Result, string.Join(Environment.NewLine, rebuildLog)));

                            return attempt.Result;
                        },
                        line => Post(() => _fixLines.Add(BuildFixReport.Clean(line, scaffold.ProjectPath))));

                    return (result, (Exception?)null);
                }
                catch (Exception ex) when (ex is not OutOfMemoryException)
                {
                    return (null, ex);
                }
            });
        }
        finally
        {
            FixLocks.Leave(scaffold.ProjectPath);
            _fixing = false;
        }

        var (outcome, error) = ran;

        if (outcome is null)
        {
            // The old red build stays the offer's basis, so the user can say Yes again.
            if (!_disposed)
            {
                Finished("The fix stopped");
                _fixerThrew = true;
                _fixLines.Clear();
                _fixLines.Add(
                    $"The fix could not finish ({error!.GetType().Name}). "
                    + "The errors above are from before the fix; check the project files.");
                _phase = Phase.Done;
                Navigation.Offer(Continue);
                StateHasChanged();
            }

            return;
        }

        // Still the app the session wants? A changed answer or a review edit has discarded it, and
        // writing it back would bring a stale app to the run stage.
        var stale = !ReferenceEquals(Session.Generated, wanted)
            || Session.StateOf(BuildStage.Generate) == StageState.Pending;

        if (stale)
        {
            if (_disposed)
                return;

            Finished("The fix stopped");
            _failedBuild = null;
            _fixLines.Clear();
            _fixLines.Add("The app was changed while the fix ran, so its result was not kept.");
            _phase = Phase.Done;
            StateHasChanged();

            return;
        }

        // Handed to the session again even when the page is gone: the fix changed files on disk,
        // and the run stage needs the NEW build log to find the assembly.
        // The log of the build that outcome.LastBuild is. When that build was rejected, timed out or
        // never ran, the session keeps the log of the build it already held.
        var rebuilt = wanted?.BuildLog ?? string.Empty;

        lock (rebuildLog)
        {
            foreach (var (result, log) in rebuilds)
            {
                if (ReferenceEquals(result, outcome.LastBuild) && !result.TimedOut)
                    rebuilt = log;
            }
        }

        _fixerThrew = false;

        Session.SetGenerated(new GeneratedApp(
            scaffold,
            rebuilt,
            BuildReport.Succeeded(outcome.LastBuild),
            Persistence: _persistence));

        if (_disposed)
            return;

        Finished(outcome.Green ? "Compiled after the fix" : "The compiler still reports problems after the fix");

        // A green rebuild makes the page's earlier complaints false: the compile warning about a
        // stub the fix rewrote, the "problems" step, and the red log above the new one. A red one
        // leaves them, because the user is still looking at the same failure.
        if (outcome.Green)
        {
            _report.RemoveAll(_stubWarnings.Contains);
            _stubWarnings.Clear();
            _steps.RemoveAll(s => s.StartsWith("The compiler reported problems", StringComparison.Ordinal)
                || s.StartsWith("The compiler still reports problems", StringComparison.Ordinal));
            _log.Clear();
            _log.AddRange(rebuilt.Split(Environment.NewLine, StringSplitOptions.RemoveEmptyEntries));
        }

        _fixLines.Clear();
        _fixLines.AddRange(BuildFixReport.Lines(outcome, scaffold.ProjectPath));

        _buildLines.Clear();
        _buildLines.AddRange(BuildReport.Lines(outcome.LastBuild, elapsed, scaffold.ProjectPath));

        // Red again: the offer comes back, so the user can try another round or leave it.
        SetFailedBuild(outcome.LastBuild, scaffold.ProjectPath);
        _phase = Phase.Done;

        Navigation.Offer(Continue);
        StateHasChanged();
    }

    /// <summary>The project is already written; the step is only the move to the run node.</summary>
    private static Task<bool> Continue() => Task.FromResult(true);

    /// <summary>Ends the workflow here, for the one case the run stage cannot help with: nothing
    /// was written at all.</summary>
    private async Task Finish()
    {
        Session.Complete(GenerateStep.OutcomeFor(
            _scaffold ?? new ScaffoldResult(false, string.Empty, [], "nothing was written"),
            Target));

        await OnAdvance.InvokeAsync();
    }

}
