@using CodeGenerator.Web.Workflow
@using DataIngestion.Normalization
@using DomainDiscovery
@implements IDisposable

@if (_busy)
{
    @* The longest silence in the tool, and it is genuinely long: a local model on a CPU takes
       minutes for an ordinary domain. The seconds counting up say it is still going; the classes
       above and below the current line say what it has produced and what it still owes, which is
       what stops a real wait from reading as a hang. The step label comes from the discovery
       itself where it has one, since only it knows which of its two passes is running. *@
    <ProgressList Done="Session.Discovered.Done" Pending="Session.Discovered.Pending"
                  Current="@(Session.Discovered.Step ?? _label)" Seconds="_seconds" />
}
else if (_kept)
{
    @* Coming back to a node that has already done its work. It used to redo it - re-read the
       file with nothing ticked, or offer a Start that did nothing - and the step forward then
       replaced the reviewed model, or asked to. Now it shows what it holds, and redoing it is a
       choice with its own button. *@
    <p class="kept-model">
        @Classes(Session.Model!.Entities.Count)@(Session.ModelSource.Length > 0 ? $" - {Session.ModelSource}" : "")
    </p>

    <div class="actions">
        <button type="button" class="again" @onclick="Again">
            @(Session.HasData ? "Read the file again" : "Discover again")
        </button>
    </div>
}
else if (_read is not null)
{
    @foreach (var line in _read.Lines)
    {
        <p class="read-line">@line</p>
    }

    @if (_read.Report.Findings.Count > 0)
    {
        <p>These changes would put the data into a better shape. Tick the ones to apply.</p>

        <ul class="findings">
            @foreach (var finding in _read.Report.Findings)
            {
                <li>
                    <label class="choice">
                        <input type="checkbox" checked="@_chosen.Contains(finding)"
                               @onchange="e => Toggle(finding, (bool?)e.Value ?? false)" />
                        <strong>@finding.Headline</strong> — @finding.Proposal
                    </label>

                    @* Evidence is not decoration: a finding the user cannot inspect is a finding
                       they cannot trust. *@
                    <details>
                        <summary>Why</summary>
                        @foreach (var line in finding.Evidence)
                        {
                            <p class="evidence">@line</p>
                        }
                    </details>
                </li>
            }
        </ul>
    }

}
else
{
    @* Nothing ran and nothing failed — only reachable if the panel was reopened after its work
       was thrown away, so it offers to do it again. *@
    <div class="actions">
        <button type="button" class="start" @onclick="Start">Start</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private bool _busy;
    private string _label = string.Empty;
    private int _seconds;
    private System.Timers.Timer? _clock;
    private ReadResult? _read;
    private readonly List<NormalizationFinding> _chosen = [];

    /// <summary>Whether this entry found a model already there and is showing it rather than
    /// making another.</summary>
    private bool _kept;

    protected override async Task OnInitializedAsync() => await Start();

    private Task Start() => Run(again: false);

    /// <summary>Redoes the node's work on purpose. The step forward then asks before replacing
    /// the model, as any second model does.</summary>
    private Task Again()
    {
        _kept = false;

        return Run(again: true);
    }

    private async Task Run(bool again)
    {
        // Nothing to move on to while this runs: the discovery path advances itself, and the data
        // path has findings to tick first.
        Navigation.Withdraw();

        // Already done - a click back onto this node, a reload, a second tab, a resumed build.
        // The step forward keeps what is there: it applies nothing, so it cannot cost the review.
        if (!again && Session.Model is not null)
        {
            _kept = true;
            Navigation.Offer(() => Task.FromResult(true));
            return;
        }

        if (Session.HasData)
        {
            ReadTheFile();
            return;
        }

        _busy = true;
        _label = "Discovering the domain — a local model can take a few minutes";
        _seconds = 0;
        StartClock();

        // BuildSession is the singleton every circuit shares. A second Start() landing while the
        // first call is still running — the same reload/second-tab/restored-tab cases above, just
        // caught mid-flight instead of after — JOINS that same task instead of racing it with a
        // second, real call to the local model. Only the owner (the caller JoinDiscovery actually
        // started the task for) applies the outcome below; a caller that joined has nothing left
        // to do once its own busy state clears — acting on the outcome twice is exactly the
        // double SetModel/Advance that used to corrupt the session.
        //
        // The progress goes on the SESSION, not on this component: a reload or a second tab joins
        // the call already running, and a list kept here would leave every joiner watching a blank
        // panel for the rest of a generation it is really waiting on. The one-second clock below
        // is what repaints it, so the callback does no rendering of its own — a render per class
        // would be a render for work the timer already covers.
        var (task, owner) = Session.JoinDiscovery(
            () => Task.Run(() => DiscoveryStep.Discover(
                Session.Description, Session.WorkspaceRoot, Session.RecordDiscoveryProgress)));

        DiscoveryOutcome outcome;

        try
        {
            outcome = await task;
        }
        finally
        {
            // Only the owner clears the slot — and only once it has the outcome in hand, success
            // or failure alike — so a later "try again" starts a genuinely fresh call rather than
            // replaying this one's result.
            if (owner)
                Session.DiscoveryFinished();
        }

        _busy = false;
        StopClock();

        if (!owner)
            return;

        // A failed outcome used to be handed to SetModel anyway — an empty CandidateDomainModel,
        // labelled with the failure text, that Advance() then walked straight past onto Review.
        // The user saw the failure line flash for a moment and then a Review page with nothing on
        // it: "nothing happened". Fail() instead leaves Current on Discover, marks its node red,
        // and puts the reason on Session.FailureMessage where BuildWorkflow always shows it — and
        // the panel below falls back to its own "Start" button, since neither _busy nor _read is
        // set, so there is a way forward without hunting for the right node to click.
        if (!outcome.Succeeded)
        {
            Session.Fail(outcome.Describe());
            return;
        }

        // Which source produced these classes, always — not only when something went wrong. A
        // customer whose Ollama service has stopped must be able to see that, rather than watch
        // the tool quietly get worse. It goes on the SESSION, not on _label: Advance() below tears
        // this panel down, so anything set on the component here is never painted.
        //
        // SetModel's bool return says whether it actually applied — false means a PendingDiscard
        // question is on screen instead, asking about a model this call would discard, and
        // advancing past a node that never actually applied its answer would move Current on for
        // work the page never showed.
        if (!Session.SetModel(outcome.Model, outcome.Describe()))
            return;

        Session.Advance();

        await OnAdvance.InvokeAsync();
    }

    /// <remarks>
    /// A timer rather than a stopwatch read at render time: the fetch causes no renders of its
    /// own, so without a tick the elapsed time would sit at zero for the whole wait it exists to
    /// make bearable.
    /// </remarks>
    private void StartClock()
    {
        if (_clock is not null)
            return;

        _clock = new System.Timers.Timer(1000) { AutoReset = true };

        _clock.Elapsed += async (_, _) =>
        {
            _seconds++;

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
            {
                // The tab was closed mid-fetch. Nothing left to repaint.
                StopClock();
            }
        };

        _clock.Start();
    }

    private void StopClock()
    {
        _clock?.Stop();
        _clock?.Dispose();
        _clock = null;
    }

    public void Dispose() => StopClock();

    private void ReadTheFile()
    {
        if (!DiscoveryStep.TryRead(Session.Source!, out var read, out var error))
        {
            Session.Fail(error);
            return;
        }

        _read = read;

        // Ticked from the start: the findings applied last time, when this is a re-read, and
        // every one of them when `normalize` was typed on the line - which the manual promises and
        // the page used to ignore, opening every finding unticked.
        _chosen.Clear();
        _chosen.AddRange(read.Report.Findings.Where(finding =>
            Session.NormalizeAll || Session.Normalized.Any(n => SameFinding(n, finding))));

        // Read and analysed: the findings are ticked here and the step forward applies them.
        Navigation.Offer(Continue);
    }

    private void Toggle(NormalizationFinding finding, bool ticked)
    {
        if (ticked)
            _chosen.Add(finding);
        else
            _chosen.Remove(finding);
    }

    /// <remarks>
    /// The rows go in WITH the model, not after it. When a model is already there SetModel holds
    /// the change for the discard question and returns false; this used to set the rows anyway and
    /// report success, so "Keep the model" left the old model beside the new rows - a split-out
    /// class with none - and the page moved on as though nothing had been asked.
    /// </remarks>
    private Task<bool> Continue()
    {
        var (model, imported) = DiscoveryStep.BuildFromData(_read!, _chosen);

        return Task.FromResult(Session.SetModel(model, imported: imported, normalized: [.. _chosen]));
    }

    /// <summary>The same finding from a different read: the objects differ, the finding does not.</summary>
    private static bool SameFinding(NormalizationFinding a, NormalizationFinding b)
        => a.Kind == b.Kind
           && a.TableName == b.TableName
           && a.ProposedEntity == b.ProposedEntity
           && a.Columns.SequenceEqual(b.Columns);

    private static string Classes(int count) => $"{count} {(count == 1 ? "class" : "classes")}";

}
