@using CodeGenerator.Web.Workflow
@using Microsoft.AspNetCore.Components.Web

<p>Describe the application you want to build.</p>
<p class="hint">
    Leave it blank if you will point at a data file instead — that is a supported flow.
</p>

@* Enter belongs to the textarea: the page takes a plain step on Enter, and a description is
   the one answer on this workflow where a new line is a sentence and not a decision. *@
<textarea class="answer" rows="5" placeholder="For example: a library app where members borrow books and staff track loans." value="@_text" @onchange="e => _text = e.Value?.ToString() ?? string.Empty"
          @onkeydown="Typed" @onkeydown:stopPropagation="true">
</textarea>

<div class="actions">
    @* Cancel only. Moving on is the diagram's job — the box above holds the step forward. *@
    <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
</div>

@code {
    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private string _text = string.Empty;

    /// <summary>
    /// Swallows keys the page would otherwise act on.
    /// </summary>
    /// <remarks>
    /// The page takes a plain step on Enter; in a description Enter is a new line, and this is the
    /// one answer on the workflow where that is true. The handler is empty on purpose — the
    /// stopPropagation directive beside it is the behaviour, and Blazor applies it to a handled
    /// event.
    /// </remarks>
    private void Typed(KeyboardEventArgs key)
    {
    }

    protected override void OnInitialized()
    {
        _text = Session.Description;

        Navigation.Offer(Next);
    }

    private Task<bool> Next()
        // Blank is allowed here and refused at node 3, where "no description AND no data" is
        // the combination that has genuinely nothing to build from.
        //
        // The session's answer is passed straight back: false means it is holding the change
        // until the user says whether the model may go, and the page must not advance past a
        // question it has just put on screen.
        => Task.FromResult(Session.SetDescription(_text));
}
