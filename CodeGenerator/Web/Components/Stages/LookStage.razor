@using AppScaffolding
@using AppScaffolding.Layouts
@using CodeGenerator.App
@using CodeGenerator.Web.Workflow

@* Collapsed behind a gate, matching CustomizationWizard.GateTitle: this step is decoration, and
   a user who wants the app they came for should skip it in one click. *@
<label class="choice">
    <input type="checkbox" class="customize" checked="@_customize"
           @onchange="e => _customize = (bool?)e.Value ?? false" />
    Customize appearance and features
</label>

@* Unticked is not "defaults": the customization this build started with - remembered in
   .codegen/app-profile.json, or typed inline - still applies. Said here, with the way out, so a
   setting in force is never one the panel hides. *@
@if (!_customize && !_cleared && Applied.Count > 0)
{
    <div class="look-remembered">
        <p>These settings still apply — remembered from your last build in
            .codegen/app-profile.json, or typed with the command:</p>
        <ul>
            @foreach (var line in Applied)
            {
                <li>@line.Trim()</li>
            }
        </ul>
        <button type="button" class="look-clear" @onclick="UseDefaults">Use the defaults instead</button>
    </div>
}

@if (_customize)
{
    <div class="fields">
        @if (AsksLayout)
        {
            <label>
                Layout
                <select class="layout answer" value="@_layout"
                        @onchange="e => _layout = e.Value?.ToString() ?? _layout">
                    @foreach (var key in AppLayoutCatalog.Keys)
                    {
                        <option value="@key">@key</option>
                    }
                </select>
            </label>
        }

        <label>Company
            <input class="company answer" value="@_company"
                   @onchange="e => CompanyTyped(e.Value?.ToString())" /></label>

        <label>Theme
            <select class="theme answer" value="@_theme"
                    @onchange="e => _theme = e.Value?.ToString() ?? _theme">
                <option value="default">none</option>
                <option value="light">light</option>
                <option value="dark">dark</option>
            </select></label>

        <label>Accent colour
            <input class="accent answer" value="@_accent" placeholder="#rrggbb"
                   @onchange="e => _accent = e.Value?.ToString() ?? string.Empty" />
            @if (AccentError is not null)
            {
                <span class="field-error">@AccentError</span>
            }
        </label>

        <label>Icon path
            <input class="icon answer" value="@_icon"
                   @onchange="e => _icon = e.Value?.ToString() ?? string.Empty" /></label>

        <label>Window title
            <input class="title answer" value="@_title"
                   @onchange="e => _title = e.Value?.ToString() ?? string.Empty" /></label>

        <label>Namespace prefix
            <input class="prefix answer" value="@_prefix"
                   @onchange="e => _prefix = e.Value?.ToString() ?? string.Empty" />
            @if (PrefixError is not null)
            {
                <span class="field-error">@PrefixError</span>
            }
        </label>

        <label class="choice"><input type="checkbox" class="validation" checked="@_validation"
            @onchange="e => _validation = (bool?)e.Value ?? false" /> Validation layer</label>

        <label class="choice"><input type="checkbox" class="logging" checked="@_logging"
            @onchange="e => _logging = (bool?)e.Value ?? false" /> Logging</label>

        <label class="choice"><input type="checkbox" class="seed" checked="@_seed"
            @onchange="e => _seed = (bool?)e.Value ?? false" /> Sample seed data</label>

        @* Phrased as the console wizard phrases it. Before this the web had no way to answer it
           at all, so a web build always had a login screen unless the profile said otherwise. *@
        <label class="choice"><input type="checkbox" class="login" checked="@_login"
            @onchange="e => _login = (bool?)e.Value ?? false" /> Require a login</label>
    </div>
}

<div class="actions">
    @* Nothing here refuses the step — the box does, because Valid is what it is told. *@
    <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
</div>

@code {
    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private bool _customize;

    /// <summary>Whether "Use the defaults instead" was chosen, so Continue applies the defaults
    /// rather than the customization the build started with.</summary>
    private bool _cleared;

    /// <summary>What the session's customization sets that the defaults do not, one line each.</summary>
    private IReadOnlyList<string> Applied => CustomizationSummary.Lines(Session.Customization, Session.Target);
    private string _layout = "tabs";
    private string _company = string.Empty;
    private string _theme = "default";
    private string _accent = string.Empty;
    private string _icon = string.Empty;
    private string _title = AppCustomization.AppPlaceholder;
    private string _prefix = string.Empty;
    private bool _validation = true;
    private bool _logging;
    private bool _seed = true;
    private bool _login = true;

    /// <summary>Only a target with a window has a layout. The console wizard skips the question
    /// for the same reason.</summary>
    private bool AsksLayout
        => Session.Target is not null && AppLayouts.Supports(Session.Target.Key);

    private string? AccentError
        => _accent.Length == 0 || ThemePalette.IsValidHexColour(_accent)
            ? null
            : "A colour looks like #1f6feb.";

    private string? PrefixError
        => _prefix.Length == 0 || NamespacePrefix.IsValid(_prefix)
            ? null
            : "A prefix must be a valid namespace, like Acme or Acme.Internal.";

    private bool Valid => AccentError is null && PrefixError is null;

    /// <summary>The readiness the diagram last drew, so it is told only when that changes.</summary>
    private bool _drawnReady = true;

    /// <summary>
    /// Tells the diagram when a field edit flips whether the step is usable.
    /// </summary>
    /// <remarks>
    /// A field edit re-renders this panel alone; the box that draws Continue belongs to the page.
    /// Correcting a bad accent cleared its error here but left Continue disabled up there.
    /// </remarks>
    protected override void OnAfterRender(bool firstRender)
    {
        if (Valid == _drawnReady)
            return;

        _drawnReady = Valid;
        Navigation.ReadinessChanged();
    }

    protected override void OnInitialized()
    {
        // The step is offered but only usable while the fields are: an unusable accent disables
        // the control in the box, which is where the user is looking for the way on.
        Navigation.Offer(Next, ready: () => Valid);

        var start = Session.Customization;

        _layout = AppLayoutCatalog.KeyFor(start.EffectiveLayout);
        _company = start.Company;
        _theme = start.Theme == AppTheme.Default ? "default" : start.Theme.ToString().ToLowerInvariant();
        _accent = start.Accent ?? string.Empty;
        _icon = start.IconPath ?? string.Empty;
        _title = start.TitlePattern;
        _prefix = start.NamespacePrefix ?? string.Empty;
        _validation = start.Validation;
        _logging = start.Logging;
        _seed = start.SampleSeedData;
        _login = start.Login;

        // Open, with the values in the boxes, whenever anything differs from the defaults: a
        // remembered company or accent that the panel kept behind an unticked box was applied to
        // the app all the same.
        _customize = Applied.Count > 0;
    }

    /// <summary>Drops what was remembered: the boxes go back to the defaults, and so will the app.</summary>
    private void UseDefaults()
    {
        _cleared = true;

        var start = AppCustomization.Default;

        _layout = AppLayoutCatalog.KeyFor(start.EffectiveLayout);
        _company = start.Company;
        _theme = "default";
        _accent = string.Empty;
        _icon = string.Empty;
        _title = start.TitlePattern;
        _prefix = string.Empty;
        _validation = start.Validation;
        _logging = start.Logging;
        _seed = start.SampleSeedData;
        _login = start.Login;
    }

    /// <summary>
    /// Takes the company, and suggests the company title while the title is still the plain one.
    /// </summary>
    /// <remarks>
    /// What the console does: naming a company inline switches the title to
    /// <see cref="AppCustomization.CompanyTitlePattern"/>, and the wizard offers it. The page kept
    /// <c>{app}</c>, so the same answers gave a different window title. Suggested in the box rather
    /// than applied behind it, so it can be seen and changed.
    /// </remarks>
    private void CompanyTyped(string? typed)
    {
        _company = typed ?? string.Empty;

        if (_company.Trim().Length > 0 && _title == AppCustomization.AppPlaceholder)
            _title = AppCustomization.CompanyTitlePattern;
    }

    private Task<bool> Next()
    {
        // Applied either way, and the unchanged value is not a no-op: it is what records that this
        // node was answered at all. The customization always HAS a value, so without this the box
        // above could never tell "left at the defaults" from "never reached".
        Session.SetCustomization(
            _customize ? Compose() : _cleared ? AppCustomization.Default : Session.Customization);

        // Saved even when the gate was left off: what the user settled on this time is what the
        // next run should offer, and declining settled it too.
        CustomizationDefaults.Save(Session.WorkspaceRoot, Session.Customization);

        return Task.FromResult(true);
    }

    private AppCustomization Compose()
        => (_cleared ? AppCustomization.Default : Session.Customization) with
        {
            // Left unset when the box still shows the layout an unset one means: opening the panel
            // must not turn "the default" into a remembered explicit choice.
            Layout = AsksLayout && AppLayoutCatalog.TryResolve(_layout, out var layout)
                     && !(Session.Customization.Layout is null
                          && _layout == AppLayoutCatalog.KeyFor(Session.Customization.EffectiveLayout))
                ? layout
                : _cleared ? null : Session.Customization.Layout,
            Company = _company.Trim(),
            Theme = Enum.TryParse<AppTheme>(_theme, ignoreCase: true, out var theme)
                ? theme
                : AppTheme.Default,
            Accent = _accent.Length == 0 ? null : _accent,
            IconPath = _icon.Length == 0 ? null : _icon,
            TitlePattern = _title.Length == 0 ? AppCustomization.AppPlaceholder : _title,
            NamespacePrefix = _prefix.Trim(),
            Validation = _validation,
            Logging = _logging,
            SampleSeedData = _seed,
            Login = _login,
        };

}
