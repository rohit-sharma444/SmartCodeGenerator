@using AppScaffolding.Screens
@using CodeGenerator.App
@using CodeGenerator.Web.Workflow
@using DomainDiscovery.Model
@using DomainDiscovery.Review

@* The model, on screen. In the console PrintModel is almost entirely commented out because a
   thirty-class domain reprinted after every edit was unusable — so the review loop currently
   edits a model the user cannot see. This is the fix.

   Node 6 of 9, and structure only: what the classes are called and what is in them. How they
   connect, which of them get a screen, and what will be written are node 7's, because one page
   carrying all four made the confirmation something you reached by scrolling past the thing
   being confirmed. *@

<div class="review">
    @* Where these classes came from. The Discover panel cannot say it — Advance() removes that
       panel the instant discovery finishes — so this is the first surface that can. *@
    @if (!string.IsNullOrWhiteSpace(Session.ModelSource))
    {
        <p class="model-source">@Session.ModelSource</p>
    }

    <div class="entities">
        @foreach (var entity in Model.Entities.ToList())
        {
            <article class="entity" data-entity="@entity.Name">
                <header>
                    @* Keyed on _refusals for the reason spelled out at that field. *@
                    <input class="entity-name" value="@entity.Name" @key="(entity, _refusals)"
                           @onchange="e => Rename(entity, e.Value?.ToString())" />
                    @* What kind of thing this is, before its name is read. EntityRole.None is
                       the classifier saying it could not tell, which is not a fact worth a chip
                       of its own — an empty label would read as a role called "none". *@
                    @if (entity.Role != DomainDiscovery.Enrichment.EntityRole.None)
                    {
                        <span class="role-chip role-@entity.Role.ToString().ToLowerInvariant()">@entity.Role</span>
                    }

                    <span class="provenance">@entity.Provenance</span>
                    <button type="button" class="why" @onclick="() => Why(entity.Name)">why</button>
                    <button type="button" class="remove" @onclick="() => Remove(entity.Name)">
                        remove
                    </button>
                </header>

                <ul class="fields">
                    @foreach (var field in entity.Fields.ToList())
                    {
                        @* Keyed on _refusals, which is what puts the real name back in the box
                           when the editor says no. Blazor does not repaint an attribute whose
                           value has not changed, so after a refusal the model still held "Title"
                           while the box on screen read "Book" - the card stating a name the model
                           does not have. Changing the key discards the row and builds a new one
                           from the model.

                           On the row rather than on the two controls inside it: two siblings may
                           not share a key, and one key for the row says the plainer thing anyway.

                           Found by typing into the real page. No bUnit test can see it, because
                           .Change() dispatches the event without ever putting the text in the DOM,
                           so the box it reads back was never the one the user typed into. *@
                        <li @key="(field, _refusals)">
                            @* Editable in place, like the class name above it. Until now the only
                               way to correct a property was to delete it and add it back, which
                               loses the type it had. *@
                            <input class="field-name" value="@field.Name"
                                   @onchange="e => RenameField(entity.Name, field, e.Value?.ToString())" />

                            @* The type discovery inferred is a guess, and this is the last screen
                               before Roslyn emits it. *@
                            <select class="field-type" value="@field.Type"
                                    @onchange="e => Retype(entity.Name, field, e.Value?.ToString())">
                                @foreach (var type in ModelEditor.SupportedTypes)
                                {
                                    <option value="@type" selected="@(type == field.Type)">@type</option>
                                }
                            </select>

                            <button type="button" class="unfield"
                                    @onclick="() => RemoveField(entity.Name, field.Name)">
                                ×
                            </button>
                        </li>
                    }
                </ul>

                <div class="add-field-row">
                    <input class="field-name" placeholder="new field"
                           @onchange="e => _newField = e.Value?.ToString() ?? string.Empty" />

                    @* Built from the list the editor enforces, so a type this offers cannot be
                       one it will refuse. *@
                    <select class="field-type" @onchange="TypeChosen">
                        @foreach (var type in ModelEditor.SupportedTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>

                    <button type="button" class="add-field" @onclick="() => AddField(entity.Name)">
                        add field
                    </button>
                </div>
            </article>
        }
    </div>

    @if (Model.Suggestions.Count > 0)
    {
        @* Offered rather than deleted: not knowing an entity's fields is not the same as knowing
           it is not an entity. Invisible in the console, which is the single largest thing the
           terminal hides. *@
        <aside class="suggestions">
            <h3>Also found</h3>
            @foreach (var suggestion in Model.Suggestions.ToList())
            {
                <button type="button" class="promote" @onclick="() => Promote(suggestion.Name)">
                    + @suggestion.Name
                </button>
            }
        </aside>
    }
</div>

<div class="add-class-row">
    <input class="new-class answer" placeholder="new class"
           @onchange="e => _newClass = e.Value?.ToString() ?? string.Empty" />
    <button type="button" class="add-class" @onclick="AddClass">add class</button>
</div>

@if (_message is not null)
{
    <p class="edit-report" aria-live="polite">@_message</p>
}

@if (_why.Count > 0)
{
    <section class="why-panel">
        <h3>Why this model</h3>
        @foreach (var line in _why)
        {
            <p>@line</p>
        }
        <button type="button" @onclick="() => _why.Clear()">close</button>
    </section>
}

<div class="actions">
    @* Generating is the step forward, so it is named in the box rather than buried under a screen
       of entity cards the user has to scroll past to find it. *@
    <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
</div>

@code {
    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private CandidateDomainModel Model => Session.Model!;

    /// <summary>
    /// The step forward is Output, not Generate: this node settles what the classes ARE, and the
    /// next one settles what comes out of them and how they connect.
    /// </summary>
    /// <remarks>
    /// A model with no classes has nothing to carry forward, so the step is offered and disabled
    /// rather than hidden — the user can see what they are working towards.
    /// <para>
    /// Nothing to apply: the model has been edited in place all along, so this stage's step is
    /// purely the move to the next node.
    /// </para>
    /// </remarks>
    protected override void OnInitialized()
        => Navigation.Offer(
            static () => Task.FromResult(true),
            ready: () => Model.Entities.Count > 0,
            label: "Output");

    private string _newClass = string.Empty;
    private string _newField = string.Empty;
    private string _newType = "string";
    private string? _message;
    private int _refusals;
    private List<string> _why = [];

    /// <summary>
    /// Reports what <see cref="ModelEditor"/> answered.
    /// </summary>
    /// <remarks>
    /// The rules are not restated here — no control is pre-disabled by second-guessing
    /// <c>RemoveField</c> or <c>AddField</c>. A duplicated rule is a rule that will drift; asking
    /// and reporting keeps one copy.
    /// <para>
    /// Every caller is a method rather than a lambda in the markup: a Razor attribute delimited
    /// by double quotes cannot contain a double-quoted C# string.
    /// </para>
    /// </remarks>
    private void Report(bool changed, string ok, string fail)
    {
        _message = changed ? ok : fail;

        // What the keyed inputs above hang off. A refused edit leaves text in a box that the
        // model did not accept, and the only way to get it back in step is to replace the
        // element - which Blazor does when its key changes and not otherwise.
        if (!changed)
            _refusals++;

        // Here rather than at each caller, because this is the one place all of them pass
        // through - and an edit that is not saved is the work a closed tab loses. Called even
        // when the editor refused: changed=false means the model is as it was, and a needless
        // save is far cheaper than a missed one.
        Session.ModelEdited();
    }

    private void Remove(string entityName)
        => Report(
            ModelEditor.RemoveEntity(Model, entityName),
            $"Removed {entityName}.",
            "Could not remove.");

    private void RemoveField(string entityName, string fieldName)
        => Report(
            ModelEditor.RemoveField(Model, entityName, fieldName),
            $"Removed {fieldName}.",
            "Could not remove that field — Name and a class's last field both stay.");

    /// <summary>
    /// Corrects a property's name in place, keeping the type and provenance it already had.
    /// </summary>
    /// <remarks>
    /// A blank box is left alone rather than reported: clearing the field and tabbing out is how
    /// someone abandons an edit, and answering that with "could not rename" reads as a failure
    /// where nothing was asked. <see cref="ModelEditor.RenameField"/> also treats a name that
    /// normalizes to the one already there as no change, so retyping the same name is silent too
    /// — hence the guard here rather than a bare call.
    /// </remarks>
    private void RenameField(string entityName, CandidateField field, string? typed)
    {
        var name = (typed ?? string.Empty).Trim();
        var fieldName = field.Name;

        if (name.Length == 0 || name == fieldName)
            return;

        Report(
            ModelEditor.RenameField(Model, entityName, fieldName, name),
            $"Renamed {fieldName} to {name}.",
            "Could not rename that property. The name must be new to the class, a valid "
            + "identifier, and neither 'Id' (generated) nor the class's own name.");
    }

    /// <summary>Overrules the type <c>TypeInference</c> guessed for a property.</summary>
    /// <remarks>
    /// Picking the type the property already has is left alone rather than reported. The editor
    /// answers "no change" to it - correctly, nothing changed - and reporting that as "could not
    /// change that type" would put a failure on screen for choosing the right answer.
    /// </remarks>
    private void Retype(string entityName, CandidateField field, string? chosen)
    {
        if (chosen is null || chosen == field.Type)
            return;

        var fieldName = field.Name;

        Report(
            ModelEditor.ChangeFieldType(Model, entityName, fieldName, chosen),
            $"{fieldName} is now {chosen}.",
            "Could not change that type.");
    }

    private void TypeChosen(ChangeEventArgs e)
        => _newType = e.Value?.ToString() ?? "string";

    private void Rename(CandidateEntity entity, string? typed)
    {
        var name = (typed ?? string.Empty).Trim();

        if (name.Length == 0 || name == entity.Name)
            return;

        Report(
            ModelEditor.RenameEntity(Model, entity.Name, name),
            $"Renamed to {name}.",
            "Could not rename — the name may already be in use.");
    }

    private void AddClass()
    {
        // BuildAppCommand.AddLine reports the name the model actually received, which is not
        // always the name typed: promoting a suggestion keeps the suggestion's own spelling.
        _message = BuildAppCommand.AddLine(Model, ["add", _newClass]);
        _newClass = string.Empty;
        Session.ModelEdited();
    }

    private void Promote(string name)
    {
        _message = BuildAppCommand.AddLine(Model, ["add", name]);
        Session.ModelEdited();
    }

    private void AddField(string entityName)
    {
        // The type is explicit, so TypeInference is deliberately bypassed: the drop-down is the
        // user overriding a guess before it is made.
        Report(
            ModelEditor.AddField(Model, entityName, _newField, _newType),
            $"Added {_newField} to {entityName}.",
            "Could not add that field. The name must be new, a valid identifier, and neither "
            + "'Id' (generated) nor the class's own name.");

        _newField = string.Empty;
    }

    private void Why(string name) => _why = [.. DecisionReport.ForName(Model, name)];
}
