@using AppScaffolding.Screens
@using CodeGenerator.App
@using CodeGenerator.Web.Workflow
@using DomainDiscovery.Model
@using DomainDiscovery.Review

@* The model, on screen. In the console PrintModel is almost entirely commented out because a
   thirty-class domain reprinted after every edit was unusable — so the review loop currently
   edits a model the user cannot see. This is the fix. *@

@* Once per render rather than per class: every card asks it, and it is worked out from the model
   as it stands right now — an edit made a moment ago has to be able to move a class across. Null
   for a target with no screens, which is the whole question not being put. *@
@{
    var plan = Session.Target?.HasScreens == true
        ? ScreenPlan.For(Model, Session.Customization, Session.Target)
        : null;
}

<div class="review">
    @* Inside the panel grid and spanning both its columns, not floated above it: .review is
       1fr + 220px, so a diagram outside it ran the full width while everything below stopped
       220px short of the same right edge. Above the list rather than inside it, because a
       relationship is between two classes and belongs to the model, not to either card. *@
    <RelationshipDiagram Sources="Sources()" />

    <div class="entities">
        @foreach (var entity in Model.Entities.ToList())
        {
            <article class="entity" data-entity="@entity.Name">
                <header>
                    <input class="entity-name" value="@entity.Name"
                           @onchange="e => Rename(entity, e.Value?.ToString())" />
                    <span class="provenance">@entity.Provenance</span>
                    <button type="button" class="why" @onclick="() => Why(entity.Name)">why</button>
                    <button type="button" class="remove" @onclick="() => Remove(entity.Name)">
                        remove
                    </button>
                </header>

                @* Its own row rather than a fourth item in the header. The screen a class gets is
                   a FACT about it, and beside why and remove it read as a third action — while on
                   a line card, whose control is a phrase AND a button, it pushed remove onto a
                   third row on its own. *@
                @if (plan is not null)
                {
                    var role = plan.RoleOfEntity(entity.Name);

                    <div class="screen">
                        @* A line is not offered the two-way choice. Asking for "transaction" on
                           one is an answer EntityRoles drops in its second pass — only a MASTER
                           override skips line detection — so the single correction that does work
                           is the only one offered. *@
                        @if (role == EntityRole.DocumentLine)
                        {
                            <span class="role-line">lines of @plan.TransactionHolding(entity.Name)</span>
                            <button type="button" class="own-screen"
                                    @onclick="() => OwnScreen(entity.Name)">
                                own screen
                            </button>
                        }
                        else
                        {
                            <span class="screen-label">screen</span>
                            <select class="role" value="@role"
                                    @onchange="e => ChooseRole(entity.Name, e.Value?.ToString())">
                                <option value="@nameof(EntityRole.Master)"
                                        selected="@(role == EntityRole.Master)">master</option>
                                <option value="@nameof(EntityRole.Transaction)"
                                        selected="@(role == EntityRole.Transaction)">transaction</option>
                            </select>
                        }
                    </div>
                }

                <ul class="fields">
                    @foreach (var field in entity.Fields.ToList())
                    {
                        <li>
                            <span class="field-name">@field.Name</span>
                            <span class="field-type">@field.Type</span>
                            <button type="button" class="unfield"
                                    @onclick="() => RemoveField(entity.Name, field.Name)">
                                ×
                            </button>
                        </li>
                    }
                </ul>

                <div class="add-field-row">
                    <input class="field-name" placeholder="new field"
                           @onchange="e => _newField = e.Value?.ToString() ?? string.Empty" />

                    @* The five ModelEditor accepts. A sixth here would compile and then fail. *@
                    <select class="field-type" @onchange="TypeChosen">
                        <option value="string">string</option>
                        <option value="int">int</option>
                        <option value="decimal">decimal</option>
                        <option value="bool">bool</option>
                        <option value="DateTime">DateTime</option>
                    </select>

                    <button type="button" class="add-field" @onclick="() => AddField(entity.Name)">
                        add field
                    </button>
                </div>
            </article>
        }
    </div>

    @if (Model.Suggestions.Count > 0)
    {
        @* Offered rather than deleted: not knowing an entity's fields is not the same as knowing
           it is not an entity. Invisible in the console, which is the single largest thing the
           terminal hides. *@
        <aside class="suggestions">
            <h3>Also found</h3>
            @foreach (var suggestion in Model.Suggestions.ToList())
            {
                <button type="button" class="promote" @onclick="() => Promote(suggestion.Name)">
                    + @suggestion.Name
                </button>
            }
        </aside>
    }

    <aside class="settled">
        <h3>Will generate</h3>
        <p>@(Session.Target is null ? "not chosen" : ApplicationTypeMenu.LabelFor(Session.Target))</p>
        @foreach (var line in CustomizationSummary.Lines(Session.Customization))
        {
            <p>@line</p>
        }

        @* The sentence the build output has always ended with, moved to where it can still be
           acted on rather than reporting a split after the code carrying it was written. *@
        @if (plan is not null)
        {
            <p class="screen-summary">@ScreenSummary.Describe(plan.Roles)</p>
        }

        @* Every answer so far, as the line that would give them all at once. Here rather than at
           the end because this is where the answers are settled and where someone deciding to do
           it differently is standing. *@
        <h3>The same run as a command</h3>
        <pre class="command-echo">@string.Join(Environment.NewLine, BuildCommandEcho.For(Session))</pre>
    </aside>
</div>

<div class="add-class-row">
    <input class="new-class answer" placeholder="new class"
           @onchange="e => _newClass = e.Value?.ToString() ?? string.Empty" />
    <button type="button" class="add-class" @onclick="AddClass">add class</button>
</div>

@if (_message is not null)
{
    <p class="edit-report" aria-live="polite">@_message</p>
}

@if (_why.Count > 0)
{
    <section class="why-panel">
        <h3>Why this model</h3>
        @foreach (var line in _why)
        {
            <p>@line</p>
        }
        <button type="button" @onclick="() => _why.Clear()">close</button>
    </section>
}

<div class="actions">
    @* Generating is the step forward, so it is named in the box rather than buried under a screen
       of entity cards the user has to scroll past to find it. *@
    <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
</div>

@code {
    /// <summary>The model, in the shape the diagram takes.</summary>
    /// <remarks>
    /// The same resolution DomainModelMapper applies is left to the layout, so the picture and the
    /// generator cannot disagree about which targets count.
    /// </remarks>
    private List<RelationshipSource> Sources() =>
        [.. Model.Entities.Select(e => new RelationshipSource(
            e.Name,
            [.. e.Relationships.Select(r => r.Target)],
            [.. e.Fields.Select(f => f.Name)]))];

    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private CandidateDomainModel Model => Session.Model!;

    /// <summary>A model with no classes has nothing to generate, so the step is offered and
    /// disabled rather than hidden — the user can see what they are working towards.</summary>
    protected override void OnInitialized()
        => Navigation.Offer(Generate, ready: () => Model.Entities.Count > 0, label: "Generate");

    private string _newClass = string.Empty;
    private string _newField = string.Empty;
    private string _newType = "string";
    private string? _message;
    private List<string> _why = [];

    /// <summary>
    /// Reports what <see cref="ModelEditor"/> answered.
    /// </summary>
    /// <remarks>
    /// The rules are not restated here — no control is pre-disabled by second-guessing
    /// <c>RemoveField</c> or <c>AddField</c>. A duplicated rule is a rule that will drift; asking
    /// and reporting keeps one copy.
    /// <para>
    /// Every caller is a method rather than a lambda in the markup: a Razor attribute delimited
    /// by double quotes cannot contain a double-quoted C# string.
    /// </para>
    /// </remarks>
    private void Report(bool changed, string ok, string fail)
    {
        _message = changed ? ok : fail;

        // Here rather than at each caller, because this is the one place all of them pass
        // through - and an edit that is not saved is the work a closed tab loses. Called even
        // when the editor refused: changed=false means the model is as it was, and a needless
        // save is far cheaper than a missed one.
        Session.ModelEdited();
    }

    private void Remove(string entityName)
        => Report(
            ModelEditor.RemoveEntity(Model, entityName),
            $"Removed {entityName}.",
            "Could not remove.");

    private void RemoveField(string entityName, string fieldName)
        => Report(
            ModelEditor.RemoveField(Model, entityName, fieldName),
            $"Removed {fieldName}.",
            "Could not remove that field — Name and a class's last field both stay.");

    private void TypeChosen(ChangeEventArgs e)
        => _newType = e.Value?.ToString() ?? "string";

    private void Rename(CandidateEntity entity, string? typed)
    {
        var name = (typed ?? string.Empty).Trim();

        if (name.Length == 0 || name == entity.Name)
            return;

        Report(
            ModelEditor.RenameEntity(Model, entity.Name, name),
            $"Renamed to {name}.",
            "Could not rename — the name may already be in use.");
    }

    private void AddClass()
    {
        // BuildAppCommand.AddLine reports the name the model actually received, which is not
        // always the name typed: promoting a suggestion keeps the suggestion's own spelling.
        _message = BuildAppCommand.AddLine(Model, ["add", _newClass]);
        _newClass = string.Empty;
        Session.ModelEdited();
    }

    private void Promote(string name)
    {
        _message = BuildAppCommand.AddLine(Model, ["add", name]);
        Session.ModelEdited();
    }

    private void AddField(string entityName)
    {
        // The type is explicit, so TypeInference is deliberately bypassed: the drop-down is the
        // user overriding a guess before it is made.
        Report(
            ModelEditor.AddField(Model, entityName, _newField, _newType),
            $"Added {_newField} to {entityName}.",
            "Could not add that field. The name must be new, a valid identifier, and neither "
            + "'Id' (generated) nor the class's own name.");

        _newField = string.Empty;
    }

    private void Why(string name) => _why = [.. DecisionReport.ForName(Model, name)];

    /// <summary>Pulls a line out to a screen of its own — the master override, which is what
    /// <c>EntityRoles</c> lets skip line detection.</summary>
    private void OwnScreen(string entityName) => Choose(entityName, EntityRole.Master);

    private void ChooseRole(string entityName, string? value)
    {
        if (Enum.TryParse<EntityRole>(value, out var chosen))
            Choose(entityName, chosen);
    }

    /// <summary>
    /// Records the choice as <see cref="ScreenChoice"/> wants it: against the role the classifier
    /// reaches on its own.
    /// </summary>
    /// <remarks>
    /// The baseline is computed from a customization with this class's own answer taken OUT,
    /// rather than from the heuristic in isolation: the other classes' answers can move this one
    /// (a line's parent is a line's parent because of how the parent was classified), and using
    /// the wrong baseline would record an override that agrees with what was going to happen
    /// anyway — putting a class in the replay line that nobody moved.
    /// <para>
    /// The name recorded is the CLASS name, not the entity name on screen. They differ when the
    /// mapper renames a collision, and <c>ScreenOverrides</c> is matched against the class — so
    /// storing what the card is labelled with would be an answer the generator quietly ignores.
    /// </para>
    /// </remarks>
    private void Choose(string entityName, EntityRole chosen)
    {
        var target = Session.Target!;
        var className = ScreenPlan.For(Model, Session.Customization, target).ClassNameOf(entityName);

        var cleared = ScreenChoice.Clear(Session.Customization, className);
        var baseline = ScreenPlan.For(Model, cleared, target).RoleOfEntity(entityName);

        Session.SetCustomization(
            ScreenChoice.Set(Session.Customization, className, chosen, baseline));
    }

    /// <summary>Nothing to apply: the model has been edited in place all along, so this stage's
    /// step is purely the move to the generate node.</summary>
    private static Task<bool> Generate() => Task.FromResult(true);
}
