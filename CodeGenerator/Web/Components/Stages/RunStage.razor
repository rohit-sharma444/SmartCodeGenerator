@using AppScaffolding
@using AppScaffolding.Targets
@using CodeGenerationEngine.Models
@using CodeGenerator.App
@using CodeGenerator.Web.Workflow

@* The last node. Compiling is not the same as working, so starting it is a step of its own rather
   than a button on the generate panel — and the diagram then says the run is still ahead. *@

@if (App is null)
{
    <p>Nothing has been generated yet.</p>
}
else if (!Runnable)
{
    <p class="notice">@WhyNot</p>
}
else
{
    <p>
        <strong>@App.Scaffold.ProjectPath</strong> compiled. Start it to see it working —
        it runs as a separate process and keeps running after this page closes.
    </p>
}

@foreach (var line in _report)
{
    <p class="report-line">@line</p>
}

@if (App is not null)
{
    @* The next steps are worth having on screen and not only in the console the user has just
       stopped looking at. *@
    <h3>Next steps</h3>
    <ul class="next-steps">
        @* NextSteps.Lines leads with its own heading, which is a heading here rather than the
           first bullet of its own list. *@
        @foreach (var line in NextSteps.Lines(
            Target, App.Scaffold.ProjectPath, App.Scaffold.TestProjectPath,
            App.Scaffold.FilesWritten).Where(l => l.Trim() != "Next steps:"))
        {
            <li>@line</li>
        }
    </ul>
}

<div class="actions">
    <button type="button" class="back" @onclick="Back">Back</button>

    @if (Runnable)
    {
        <button type="button" class="run" disabled="@_starting" @onclick="Start">
            @(_started ? "Start it again" : "Run it now")
        </button>
    }

    <button type="button" class="finish" @onclick="Finish">Done</button>
</div>

@code {
    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private readonly List<string> _report = [];
    private bool _starting;
    private bool _started;

    private GeneratedApp? App => Session.Generated;

    private ITargetScaffolder Target => Session.Target ?? TargetScaffolders.Default;

    private bool Runnable => GenerateStep.CanRun(App, Target);

    /// <summary>Why there is no button. Each case is a different thing for the user to do next,
    /// so each says so rather than sharing one vague sentence.</summary>
    private string WhyNot
        => App is null
            ? "Nothing has been generated yet."
            : !App.Scaffold.Success
                ? $"Nothing was written: {App.Scaffold.Message}"
                : !App.BuildSucceeded
                    ? "The generated project did not build, so there is nothing to start yet. "
                      + "Go back to see the build log, or open the project and fix it."
                    : "A class library has nothing to start. Reference it from an application "
                      + "instead — the steps below say how.";

    private async Task Start()
    {
        _starting = true;
        _report.Clear();

        var isWebApp = Target.ProjectType == DotNetProjectType.BlazorServer;

        // Off the circuit's thread: a web app is waited for until it answers, and that wait would
        // otherwise hold the render loop and leave the page looking dead.
        var launched = await Task.Run(() => AppLauncher.Launch(
            App!.Scaffold.ProjectPath, App.BuildLog, fromProjectFolder: isWebApp));

        _report.Add(launched is null
            ? "Could not start the app — use the command below."
            : $"Started {launched}");

        // A web app shows nothing of its own and waits to be visited, so opening it once
        // something answers is what makes the offer honest.
        if (launched is not null && isWebApp)
        {
            var url = LaunchSettingsReader.HttpUrl(App!.Scaffold.ProjectPath);

            if (url is not null && await Task.Run(() => WebAppStart.Wait(url)))
            {
                WebAppStart.OpenBrowser(url);
                _report.Add($"Opened {url}");
            }
            else if (url is not null)
            {
                _report.Add($"It has not answered on {url} yet — try that address in a moment.");
            }
        }

        _started = launched is not null;
        _starting = false;
    }

    private async Task Finish()
    {
        if (App is null)
        {
            // Only reachable if this node was opened without a generation behind it. Ending on
            // the Cancelled wording is honest: nothing was written.
            Session.Complete(BuildOutcome.Cancelled);
            await OnAdvance.InvokeAsync();
            return;
        }

        var outcome = GenerateStep.OutcomeFor(App.Scaffold, Target);

        // What happened here goes to the console too: the user watched it in the browser and then
        // goes back to a prompt that should say the same thing.
        Session.Complete(_report.Count == 0
            ? outcome
            : new BuildOutcome(outcome.Phase, [.. outcome.Lines, .. _report]));

        await OnAdvance.InvokeAsync();
    }

    private async Task Back()
    {
        Session.GoTo(BuildStage.Generate);
        await OnAdvance.InvokeAsync();
    }
}
