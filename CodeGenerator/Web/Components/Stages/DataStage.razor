@using CodeGenerator.Web.Workflow
@using DataIngestion
@using DataIngestion.Schema.Readers
@using DataIngestion.Schema.Readers.Sql
@using Microsoft.AspNetCore.Components.Forms

<p>Is there data to read, or should the domain be discovered from the web?</p>

<label class="choice">
    <input type="radio" name="data" value="none" checked="@(!_hasFile)"
           @onchange="() => Choose(false)" />
    No data — discover the domain from the web
</label>

<label class="choice">
    <input type="radio" name="data" value="file" checked="@_hasFile"
           @onchange="() => Choose(true)" />
    I have a file
</label>

@if (_hasFile)
{
    <div class="file">
        <label>
            Format
            <select class="answer" value="@_format" @onchange="e => _format = e.Value?.ToString() ?? _format">
                @foreach (var key in DataSourceReaders.Keys)
                {
                    <option value="@key" disabled="@(!Readable(key))">@Label(key)</option>
                }
            </select>
        </label>

        @if (IsSql)
        {
            @* A connection string, not a path - and nothing is read until the tables are
               listed and one is ticked. *@
            <label>
                Connection
                <input class="connection answer" value="@_connection"
                       @onchange="e => _connection = e.Value?.ToString() ?? string.Empty" />
            </label>

            <button type="button" class="connect" @onclick="Connect">connect</button>

            @if (_tables.Count > 0)
            {
                @* Counts before the choice, not after. Every row of what is ticked is read,
                   with no cap, so the number beside each table is what makes ticking it an
                   informed decision rather than a guess. *@
                <table class="tables">
                    <tbody>
                    @foreach (var table in _tables)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="table-pick"
                                       checked="@_picked.Contains(table.Name)"
                                       @onchange="e => Pick(table.Name, (bool?)e.Value ?? false)" />
                            </td>
                            <td class="table-name">@($"{table.Schema}.{table.Name}")</td>
                            <td class="cols">@table.Columns cols</td>
                            <td class="rows">@RowCount(table.Rows) rows</td>
                        </tr>
                    }
                    </tbody>
                </table>

                <p class="picked" aria-live="polite">@Picked()</p>
            }
        }
        else
        {
            @* A path box rather than only a file picker: the server IS this machine, and a
               path is what DataSourceSpec.Location holds. The drop zone below is the
               convenience. *@
            <label>
                Path
                <input class="path answer" value="@_path" @onchange="PathGiven" />
            </label>

            @if (_peek is not null)
            {
                @* Said before the click, not after: a wrong file costs a discovery run to
                   find out about otherwise. *@
                <p class="peek" aria-live="polite">@_peek</p>
            }

            <InputFile OnChange="Upload" class="drop answer" />
            <span class="hint">…or drop a file here to copy it into the workspace cache.</span>
        }
    </div>
}

@if (_error is not null)
{
    <p class="failure" role="alert">@_error</p>
}

<div class="actions">
    <button type="button" class="cancel" @onclick="() => Session.RequestCancel()">Cancel</button>
</div>

@code {
    /// <summary>Ten megabytes. The 512 KB default rejects an ordinary spreadsheet.</summary>
    private const long MaxUpload = 10 * 1024 * 1024;

    [Parameter, EditorRequired] public required BuildSession Session { get; set; }
    [Parameter, EditorRequired] public required StageNavigation Navigation { get; set; }
    [Parameter] public EventCallback OnAdvance { get; set; }

    private bool _hasFile;
    private string _format = "csv";
    private string _path = string.Empty;
    private string? _error;
    private string? _peek;

    private string _connection = string.Empty;
    private IReadOnlyList<SqlTableInfo> _tables = [];
    private readonly HashSet<string> _picked = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Where the table list comes from. A test supplies a database; a real run gets SqlClient.
    /// </summary>
    /// <remarks>
    /// A parameter with a default rather than an injected service, so nothing has to be
    /// registered and every existing render of this panel keeps working untouched. Constructing
    /// the adapter costs nothing - it opens no connection until a method on it is called.
    /// </remarks>
    [Parameter] public ISqlSchemaSource SchemaSource { get; set; } = new SqlClientSchemaSource();

    private bool IsSql
        => string.Equals(_format, "sql", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        // Offered unconditionally: a path that does not exist is reported after the click, which
        // is friendlier than a control that stays dark without saying why.
        Navigation.Offer(Next);

        if (Session.Source is null)
            return;

        _hasFile = true;
        _format = Session.Source.Kind.ToString().ToLowerInvariant();

        if (Session.Source.Kind == DataSourceKind.Sql)
        {
            // Coming back to this node holds the connection and the tables that were ticked,
            // but not the listing - re-reading it would open a connection nobody asked for.
            _connection = Session.Source.Location;

            foreach (var name in Session.Source.SqlTables ?? [])
                _picked.Add(name);

            return;
        }

        _path = Session.Source.Location;

        // Coming back to this node shows what the answer it holds actually contains, rather than
        // only the path it was given.
        Peek();
    }

    private void PathGiven(ChangeEventArgs e)
    {
        _path = e.Value?.ToString() ?? string.Empty;

        Peek();
    }

    /// <summary>
    /// Says what the named file holds, when it can.
    /// </summary>
    /// <remarks>
    /// Silent about anything it cannot answer — a half-typed path is not a mistake yet, and a panel
    /// that objected on every keystroke would train the user to ignore it. Refusals belong to the
    /// click, where <see cref="Next"/> already reports them.
    /// <para>
    /// This reads the file, which the discover stage will read again. Worth it: the read is the only
    /// honest way to say how many rows are in there, and finding out at the click before discovery
    /// costs a great deal less than finding out from the model after it.
    /// </para>
    /// </remarks>
    private void Peek()
    {
        _peek = null;

        // Relative to the workspace, as `build app from csv <file>` is.
        var path = DataSourcePath.Resolve(Unquoted(_path), Session.WorkspaceRoot);

        if (path.Length == 0 || !File.Exists(path))
            return;

        if (!DataSourceReaders.TryParseKind(_format, out var kind)
            || !DataSourceReaders.TryCreate(kind, out _))
            return;

        if (DiscoveryStep.TryRead(new DataSourceSpec(kind, path), out var read, out _))
            _peek = DataPeek.Describe(read);
    }

    /// <summary>
    /// Lists what the database holds. Reads no data.
    /// </summary>
    /// <remarks>
    /// Whatever the server said is what the user is shown. A driver naming a bad password or
    /// an unreachable host says it far better than anything invented here, and the stage
    /// stays usable so the connection can be corrected in place.
    /// </remarks>
    private void Connect()
    {
        _error = null;
        _tables = [];
        _picked.Clear();

        try
        {
            _tables = new SqlServerCatalog(SchemaSource).List(_connection);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Pick(string name, bool on)
    {
        if (on)
            _picked.Add(name);
        else
            _picked.Remove(name);
    }

    /// <summary>How many of the listed tables are ticked, and what that will cost.</summary>
    private string Picked()
        => _picked.Count == 0
            ? $"Nothing ticked — all {_tables.Count} tables will be read."
            : $"{_picked.Count} of {_tables.Count} tables, up to {SqlServerReader.MaxRowsPerTable:N0} rows of each.";

    /// <summary>An unreadable count is an em dash, not a zero: "I do not know" and "there is
    /// nothing in it" are different answers.</summary>
    private static string RowCount(long? rows)
        => rows is null ? "—" : rows.Value.ToString("N0");

    /// <summary>A path pasted from Explorer arrives quoted, exactly as it does in the console.</summary>
    private static string Unquoted(string value)
    {
        var path = value.Trim();

        return path.Length >= 2 && path[0] == '"' && path[^1] == '"' ? path[1..^1] : path;
    }

    private static bool Readable(string key)
        => DataSourceReaders.TryParseKind(key, out var kind)
           && DataSourceReaders.TryCreate(kind, out _);

    private static string Label(string key)
        => Readable(key) ? key : $"{key} — not in this build yet";

    /// <summary>
    /// Copies a dropped file into the workspace cache.
    /// </summary>
    /// <remarks>
    /// Everything here can fail at the user rather than at the developer: a file over the cap, a
    /// workspace path too long for Windows, a folder that cannot be written. Thrown from a handler
    /// it took the circuit with it — the page froze and the console was told the tab had closed —
    /// so a spreadsheet that is too big is reported as the sentence it is.
    /// </remarks>
    private async Task Upload(InputFileChangeEventArgs args)
    {
        // Checked before opening, because the reason is worth saying and the answer is worth
        // offering: nothing needs copying at all when the file is already on this machine.
        if (args.File.Size > MaxUpload)
        {
            _error = $"That file is {Megabytes(args.File.Size)}, and the limit for a drop is "
                     + "10 MB. Put its path in the path box instead — the server is this machine, "
                     + "so the file does not need copying anywhere.";
            return;
        }

        try
        {
            var folder = Path.Combine(Session.WorkspaceRoot, ".dd-cache", "uploads");
            Directory.CreateDirectory(folder);

            var destination = Path.Combine(folder, args.File.Name);

            await using var source = args.File.OpenReadStream(MaxUpload);
            await using var target = File.Create(destination);
            await source.CopyToAsync(target);

            _path = destination;
            _error = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _error = PanelFailure.Explain(ex);
        }
    }

    private static string Megabytes(long bytes) => $"{bytes / 1024d / 1024d:0.#} MB";

    /// <summary>
    /// Switches between no data and a file.
    /// </summary>
    /// <remarks>
    /// The error goes with the switch: whatever it said was about the other choice, and "nothing
    /// to build from" left under the file controls told the user off for a choice already changed.
    /// </remarks>
    private void Choose(bool hasFile)
    {
        _hasFile = hasFile;
        _error = null;
    }

    private Task<bool> Next()
    {
        _error = null;

        if (!_hasFile)
        {
            // The one combination with nothing to build from, refused here rather than after a
            // discovery run that would have nothing to discover.
            if (Session.Description.Length == 0)
            {
                _error = "With no description and no data there is nothing to build from — "
                         + "click Describe above and say what to build, or point at a file.";
                return Task.FromResult(false);
            }

            // False here means the session is holding the change until the user says whether
            // the model may go with it, and the page draws that question rather than advancing.
            return Task.FromResult(Session.SetNoData());
        }

        if (IsSql)
            return Task.FromResult(TakeConnection());

        // Relative to the workspace, as `build app from csv <file>` is.
        var path = DataSourcePath.Resolve(Unquoted(_path), Session.WorkspaceRoot);

        if (!File.Exists(path))
        {
            _error = $"No file at {path}.";
            return Task.FromResult(false);
        }

        if (!DataSourceReaders.TryParseKind(_format, out var kind))
        {
            _error = $"Unknown format '{_format}'.";
            return Task.FromResult(false);
        }

        if (!DataSourceReaders.TryCreate(kind, out _))
        {
            _error = DataSourceReaders.NotSupportedMessage(kind);
            return Task.FromResult(false);
        }

        return Task.FromResult(Session.SetSource(new DataSourceSpec(kind, path)));
    }

    /// <summary>
    /// Records the connection and the tables ticked.
    /// </summary>
    /// <remarks>
    /// Ticking nothing reads every table, which is the same meaning <c>tables A,B,C</c> has
    /// on the command line when it is left off - one rule, not two. Not validated beyond
    /// being non-empty: the only way to know a connection string works is to open it, and
    /// the discover step reports what the server said.
    /// </remarks>
    private bool TakeConnection()
    {
        var connection = Unquoted(_connection);

        if (connection.Length == 0)
        {
            _error = "Give a SQL Server connection string, or choose another format.";
            return false;
        }

        return Session.SetSource(new DataSourceSpec(
            DataSourceKind.Sql,
            connection,
            SqlConnectionInfo.DatabaseOf(connection),
            _picked.Count == 0 ? null : [.. _picked]));
    }

}
