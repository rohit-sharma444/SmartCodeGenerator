@page "/build"
@rendermode InteractiveServer
@using CodeGenerator.Web.Components.Stages
@using CodeGenerator.Web.Workflow
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IDisposable
@inject BuildSession Session

@* The tab, which said the same thing on every stage and in every tab. *@
<PageTitle>@StageGraph.TabTitle(Session)</PageTitle>

<main class="workflow">
    <h1>Build an application</h1>

    @* The end of the run, and the only thing on the page once it is over. The diagram and the
       panel go together rather than being left up and greyed: every box on the diagram is a click
       into BuildSession.GoTo, which throws on a workflow that has ended, and the panel behind it
       offers steps that would do the same. A screen of controls that can only fail is worse than
       no screen at all.

       Before this there was no such view: Done changed nothing here, and the next thing to happen
       was the host stopping underneath the page — which the browser reported as a server it could
       no longer find. *@
    @if (Session.Phase != SessionPhase.Running)
    {
        <div class="finished" role="status">
            <h2>@Heading</h2>

            @* The console's own report rather than a second wording of it. The user watched this
               happen in the browser and then goes back to a prompt, and the two surfaces saying
               different things about one run is how a report stops being believed. *@
            @foreach (var line in BuildAppWebHost.OutcomeFor(Session).Lines.Where(l => l.Length > 0))
            {
                <p class="finished-line">@line</p>
            }

            <p class="finished-close">
                The tool has finished with this page — you can close this tab.
            </p>
        </div>
    }
    else
    {
        <StageDiagram Session="Session" Navigation="_navigation" OnRevisit="Revisit"
                      OnContinue="Continue" />

        @if (Session.FailureMessage is not null)
        {
            <p class="failure" role="alert">@Session.FailureMessage</p>
        }

        @if (Session.PendingCancel is not null)
        {
            @* Above the panel, not inside it: cancelling is about the whole run rather than
               the answer being edited, which is what separates this from the discard question
               below. *@
            <div class="cancel-question" role="alertdialog" aria-live="assertive">
                <p>@Session.PendingCancel</p>

                <div class="actions">
                    @* Carrying on is the safe answer, so it is the one the eye lands on. *@
                    <button type="button" class="cancel-keep" @onclick="KeepBuilding">
                        Keep building
                    </button>
                    <button type="button" class="cancel-confirm" @onclick="EndTheBuild">
                        Cancel the build
                    </button>
                </div>
            </div>
        }

        @* tabindex so the section itself can hold the keyboard: the panel that opens is where the
           next answer is typed, and without this the focus falls back to the document after every
           step and the whole wizard needs a mouse. *@
        <section class="panel" tabindex="-1" @ref="_panel" @onkeydown="Typed">
            <h2>@StageGraph.Nodes.First(n => n.Stage == Session.Current).Title</h2>

            @if (Session.PendingDiscard is not null)
            {
                @* Inside the panel, above the answer that raised it: the question is about what was
                   just typed, and it belongs next to it rather than at the top of the page. *@
                <div class="discard-question" role="alertdialog" aria-live="assertive">
                    <p>@Session.PendingDiscard</p>

                    <div class="actions">
                        @* Keeping is first and Change is the plainer control, because the
                           safe answer should be the easy one to hit. *@
                        <button type="button" class="discard-keep" @onclick="KeepTheModel">
                            Keep the model
                        </button>
                        <button type="button" class="discard-confirm" @onclick="ChangeAnyway">
                            Change anyway
                        </button>
                    </div>
                </div>
            }

            @* Everything that reads a file or starts a process is inside this. A throw used to end
               the circuit, which froze the page and had the console report a closed tab. *@
            <PanelErrorBoundary @ref="_boundary" OnError="PanelFailed">
                <ChildContent>
            @* Keyed on the stage, so revisiting a node builds a fresh panel rather than reusing the
               one next door with its draft fields still in it. *@
            @switch (Session.Current)
            {
                case BuildStage.Describe:
                    <DescribeStage @key="BuildStage.Describe" Session="Session"
                                   Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.AppType:
                    <AppTypeStage @key="BuildStage.AppType" Session="Session"
                                  Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Data:
                    <DataStage @key="BuildStage.Data" Session="Session"
                               Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Look:
                    <LookStage @key="BuildStage.Look" Session="Session"
                               Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Discover:
                    <DiscoverStage @key="BuildStage.Discover" Session="Session"
                                   Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Review:
                    <ReviewStage @key="BuildStage.Review" Session="Session"
                                 Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Generate:
                    <GenerateStage @key="BuildStage.Generate" Session="Session"
                                   Navigation="_navigation" OnAdvance="Refresh" />
                    break;
                case BuildStage.Run:
                    <RunStage @key="BuildStage.Run" Session="Session"
                              Navigation="_navigation" OnAdvance="Refresh" />
                    break;
            }
                </ChildContent>
                <ErrorContent>
                    @* The message itself is above, on the failure line, because the session
                       records it and both tabs then say the same thing. *@
                    <p class="panel-broken" role="alert">
                        This step could not finish. Its box is red — click it to try again,
                        or a green box to change an answer first.
                    </p>
                </ErrorContent>
            </PanelErrorBoundary>
        </section>
    }
</main>

@code {
    /// <summary>
    /// The open panel's step forward, which the diagram draws.
    /// </summary>
    /// <remarks>
    /// Owned here because the two components that need it are siblings: the panel offers the step
    /// and the box above draws it. Held for the page's lifetime rather than per stage, so a panel
    /// that offers nothing leaves the previous offer behind — which is why every panel either
    /// offers or withdraws when it initializes.
    /// </remarks>
    private readonly StageNavigation _navigation = new();

    /// <summary>The open panel, so the keyboard can be given to it.</summary>
    private ElementReference _panel;

    /// <summary>
    /// Which stage the keyboard was last handed to, so it is handed over once per stage.
    /// </summary>
    /// <remarks>
    /// Focusing on every render would fight the user: a panel repaints when a field changes, and
    /// pulling the focus back to the section mid-answer would throw away what they were typing in.
    /// </remarks>
    private BuildStage? _focused;

    /// <summary>The boundary around the open panel, so a new stage can start clean.</summary>
    private PanelErrorBoundary? _boundary;

    protected override void OnInitialized()
    {
        _navigation.Changed += Refresh;

        // The workflow can be moved by a tab that is not this one. The panel below is chosen from
        // Session.Current, so a circuit that is never told stays on a node the workflow has left
        // — showing an answer that no longer stands and a Continue button that would take a step
        // already taken.
        Session.Changed += Repaint;
    }

    /// <summary>
    /// What the closing view leads with. A run that wrote a project and a run cancelled before it
    /// did are not the same news, so they do not share a heading.
    /// </summary>
    private string Heading => Session.Phase switch
    {
        SessionPhase.Generated => "Finished",
        SessionPhase.Cancelled => "Cancelled",
        _ => "Closed",
    };

    /// <summary>Gives the keyboard to the panel that has just opened.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Nothing to focus once the workflow is over — the panel is not rendered, and _panel is
        // then a reference to an element that never existed, which the browser answers with an
        // error rather than a no-op.
        if (Session.Phase != SessionPhase.Running || _focused == Session.Current)
            return;

        _focused = Session.Current;

        // A new stage builds a new panel, so whatever the last one threw is behind us. Without
        // this the boundary keeps showing its error content over every stage that follows.
        _boundary?.Recover();

        try
        {
            await _panel.FocusAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException)
        {
            // The tab went away between the render and the focus. There is nothing to focus and
            // nothing worth failing a workflow over.
        }
    }

    /// <summary>
    /// Turns a panel that threw into a failed stage.
    /// </summary>
    /// <remarks>
    /// Recorded on the session, so the diagram draws the node red and offers the way back it
    /// already knows how to offer, and so the other tab is told as well.
    /// </remarks>
    private void PanelFailed(Exception exception)
    {
        PanelFailure.Report(Session, exception);

        Refresh();
    }

    /// <summary>
    /// Enter takes the step the panel is offering.
    /// </summary>
    /// <remarks>
    /// Plain steps only, and for the reason <see cref="StageNavigation.IsPlainStep"/> exists: a
    /// named step is an action — Generate writes a project to disk — and it should take a
    /// deliberate click, not a key pressed at the end of a sentence. The description's textarea
    /// stops this event itself, so Enter there is still a new line.
    /// </remarks>
    private async Task Typed(KeyboardEventArgs key)
    {
        if (key.Key != "Enter" || !_navigation.IsPlainStep || !_navigation.CanContinue)
            return;

        await Continue();
    }

    public void Dispose()
    {
        _navigation.Changed -= Refresh;
        Session.Changed -= Repaint;
    }

    /// <summary>
    /// Redraws for a change that arrived from somewhere else.
    /// </summary>
    /// <remarks>
    /// Through <c>InvokeAsync</c>, because the event is raised on whichever circuit made the
    /// change and touching this one's state from that thread is exactly the race the renderer's
    /// synchronization context exists to prevent.
    /// </remarks>
    private void Repaint() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Takes the open panel's step: its answer is applied, and only then does the workflow move on.
    /// </summary>
    /// <remarks>
    /// Advancing lives here rather than in eight panels, and that is what makes
    /// <see cref="Revisit"/> safe: leaving a node can apply an answer without stepping into the
    /// stage after it, which would leave an untouched stage marked as done.
    /// </remarks>
    private async Task Continue()
    {
        if (await _navigation.ApplyAsync())
            Session.Advance();
        else
            // Not applied. Either the panel refused its own input and is saying why, or the
            // session is holding the change and wants an answer first — in which case this is
            // what the answer leads back to.
            _afterConfirming = () => { Session.Advance(); return Task.CompletedTask; };

        Refresh();
    }

    private async Task Revisit(BuildStage stage)
    {
        // The answer the panel holds is applied first where applying is safe, so clicking a box to
        // go and check something does not quietly cost the user what they just answered. Applied,
        // not advanced: the node being left is then genuinely answered, which is what GoTo records.
        // The panel itself keeps nothing — each node is keyed, so the next panel starts from the
        // session rather than from whatever the last one had typed in it.
        if (_navigation.ShouldCommitBeforeLeaving && !await _navigation.ApplyAsync())
        {
            // The commit is waiting on the discard question. Going anyway would answer it by
            // walking away — the user would be reading another node while the thing they were
            // asked about happened behind them — so the click waits here for its answer.
            _afterConfirming = () => { Session.GoTo(stage); return Task.CompletedTask; };

            Refresh();
            return;
        }

        Session.GoTo(stage);
        Refresh();
    }

    /// <summary>
    /// Where the click that raised the discard question was going. Run only if the user says the
    /// model may go: the click and the confirmation are one decision, and half of it is worse
    /// than neither.
    /// </summary>
    private Func<Task>? _afterConfirming;

    private async Task ChangeAnyway()
    {
        Session.ConfirmPending();

        var next = _afterConfirming;
        _afterConfirming = null;

        if (next is not null)
            await next();

        Refresh();
    }

    /// <summary>
    /// Ends the workflow, the cancel question having been answered.
    /// </summary>
    /// <remarks>
    /// The session decides whether the question is asked at all — a first page with nothing on it
    /// cancels outright — so there is nothing for the page to work out here.
    /// </remarks>
    private void EndTheBuild()
    {
        Session.ConfirmCancel();

        Refresh();
    }

    private void KeepBuilding()
    {
        Session.KeepBuilding();

        Refresh();
    }

    private void KeepTheModel()
    {
        Session.CancelPending();
        _afterConfirming = null;

        Refresh();
    }

    private void Refresh() => StateHasChanged();
}
