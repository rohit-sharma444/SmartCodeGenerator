@* The root component. Self-contained on purpose: no CDN, no external font. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartCodeGenerator</title>
    <base href="/" />
    <link rel="stylesheet" href="workflow.css" />
    <link rel="stylesheet" href="chat.css" />
    @* The render mode is load-bearing: the workflow page is InteractiveServer, so its PageTitle
       updates arrive on the interactive circuit. A statically rendered outlet never hears them —
       the tab kept the title below for the whole run, which no unit test can see, because the
       component IS rendered and IS handed its content either way. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes />

    @* Blazor's own lost-connection dialog, replaced.

       It only builds its default one when the page supplies no element with this id, and its
       default is a full-screen overlay that says the server cannot be found. That is the wrong
       news here twice over: this server is the tool itself, so it going away is how a run ENDS
       rather than a fault, and an overlay hides the closing view that has just been drawn to
       explain exactly that.

       Two messages, because Blazor tells the two apart and so should the page: while it is still
       retrying the connection may yet come back, and only once it has given up is the tool
       actually gone. *@
    <div id="components-reconnect-modal">
        <p class="reconnect-trying">Reconnecting to SmartCodeGenerator&hellip;</p>
        <p class="reconnect-gone">
            SmartCodeGenerator is not running any more. This page is served by the tool itself, so
            it goes quiet when the tool stops — which is how a run ends. You can close this tab.
        </p>
    </div>
    @* The clipboard is behind an API the server cannot reach, so the copy button calls out to
       this. Optional chaining because a browser with no permission has no clipboard object. *@
    <script>
        window.chatCopy = text => navigator.clipboard?.writeText(text);

        // The transcript scrolls inside its own box, so the newest turn has to be scrolled to
        // rather than being wherever the page happens to end. Optional chaining because the
        // element is gone by the time this arrives if the reader navigated away mid-command.
        window.chatScrollToEnd = element => {
            if (element) element.scrollTop = element.scrollHeight;
        };

        // Enter sends, so the browser must not also type a newline into the box. Capture phase and
        // no stopPropagation, so Blazor's own keydown listener still receives the event and decides
        // what Enter means; this only stops the character. Shift+Enter is left alone, because that
        // is the one that is meant to insert a line.
        document.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey
                && e.target instanceof HTMLTextAreaElement
                && e.target.closest('.composer')) {
                e.preventDefault();
            }
        }, true);
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
