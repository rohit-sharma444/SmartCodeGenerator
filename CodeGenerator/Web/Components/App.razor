@* The root component. Self-contained on purpose: no CDN, no external font. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartCodeGenerator</title>
    <base href="/" />
    <link rel="stylesheet" href="workflow.css" />
    <link rel="stylesheet" href="chat.css" />
    @* The render mode is load-bearing: the workflow page is InteractiveServer, so its PageTitle
       updates arrive on the interactive circuit. A statically rendered outlet never hears them —
       the tab kept the title below for the whole run, which no unit test can see, because the
       component IS rendered and IS handed its content either way. *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes />
    @* The clipboard is behind an API the server cannot reach, so the copy button calls out to
       this. Optional chaining because a browser with no permission has no clipboard object. *@
    <script>
        window.chatCopy = text => navigator.clipboard?.writeText(text);
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
