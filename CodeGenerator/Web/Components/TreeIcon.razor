@* One glyph per kind of node, the way Solution Explorer tells its rows apart.

   Inline SVG and nothing else: the page is served with no network, so an icon font is a request
   that would never come back. Every kind lives here rather than beside the row that draws it —
   six glyphs spread across three components is how two of them end up the same shape.

   The colours are per kind and the shapes are too. Colour alone would leave the tree unreadable
   to anyone who cannot separate the hues, which is why a method is a box and a property is a
   spanner rather than the same square in two tints. *@

<span class="tree-icon tree-icon-@Token" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round">
        @switch (Kind)
        {
            case TreeIconKind.Solution:
                @* Sheets in a stack: the one node everything else is inside. *@
                <path d="M12 3.3 20.6 7.6 12 11.9 3.4 7.6z" />
                <path d="M3.4 12.1 12 16.4l8.6-4.3" />
                <path d="M3.4 16.4 12 20.7l8.6-4.3" />
                break;

            case TreeIconKind.Project:
                <rect x="3.6" y="4.4" width="16.8" height="15.2" rx="2.2" />
                <path d="M3.6 9.4h16.8" />
                break;

            case TreeIconKind.Folder:
                <path d="M3.3 7.2a2 2 0 0 1 2-2h3.9l2 2h7.5a2 2 0 0 1 2 2v7.6a2 2 0 0 1-2 2H5.3a2 2 0 0 1-2-2z" />
                break;

            case TreeIconKind.FolderOpen:
                @* The same folder with its front dropped forward. *@
                <path d="M3.3 16.8V7.2a2 2 0 0 1 2-2h3.9l2 2h7.5a2 2 0 0 1 2 2v1.2" />
                <path d="M2.4 11.4h19.2l-2 7.1a2 2 0 0 1-1.9 1.3H6.3a2 2 0 0 1-2-1.5z" />
                break;

            case TreeIconKind.Class:
                @* A sheet with its corner turned: a class here is a file with its name. *@
                <path d="M13.6 3.6H7.2a2 2 0 0 0-2 2v12.8a2 2 0 0 0 2 2h9.6a2 2 0 0 0 2-2V8.9z" />
                <path d="M13.6 3.6v5.3h5.2" />
                break;

            case TreeIconKind.Property:
                @* A spanner: an open jaw, a shaft and a grip. The jaw is drawn as a bracket rather
                   than as a second stroke across the shaft — crossed at this size the two read as
                   an arrow, which is what the first attempt looked like on a real page. *@
                <path d="M19.6 4.4h-4.7v4.7" />
                <path d="M14.9 9.1 9.9 14.1" />
                <circle cx="7.6" cy="16.4" r="3.2" />
                break;

            case TreeIconKind.Method:
                @* A box seen from the corner: something that does a thing, not something that
                   holds one. *@
                <path d="M12 3.4 19.8 7.5v9L12 20.6 4.2 16.5v-9z" />
                <path d="m4.2 7.5 7.8 4.1 7.8-4.1" />
                <path d="M12 11.6v9" />
                break;
        }
    </svg>
</span>

@code {
    /// <summary>Which node this is the glyph for.</summary>
    [Parameter, EditorRequired]
    public TreeIconKind Kind { get; set; }

    /// <summary>
    /// The kind as it reads in a class name: <c>folder-open</c>, not <c>folderopen</c>.
    /// </summary>
    /// <remarks>
    /// Spelled out rather than derived from the enum name, so a kind added later cannot silently
    /// arrive as one word — and so the class the tests and the stylesheet look for is written
    /// somewhere a reader can find it.
    /// </remarks>
    private string Token => Kind switch
    {
        TreeIconKind.Solution => "solution",
        TreeIconKind.Project => "project",
        TreeIconKind.Folder => "folder",
        TreeIconKind.FolderOpen => "folder-open",
        TreeIconKind.Class => "class",
        TreeIconKind.Property => "property",
        TreeIconKind.Method => "method",
        _ => "class",
    };
}
