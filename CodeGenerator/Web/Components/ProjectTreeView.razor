@* The loaded solution as a tree: project, then class, then what the class declares. *@

@* The loop variables are `entry` and `member`, never `class`: Razor treats `class` as reserved in
   an implicit expression and `@class` in markup collides with the attribute of that name. And each
   command is built into a local before the markup, because an interpolated string inside a
   double-quoted attribute ends the attribute at its own first quote. *@

<nav class="tree" aria-label="Projects">
    @if (Projects.Count == 0)
    {
        <p class="tree-empty">
            No projects loaded. Use <strong>Change…</strong> above to point the tool at a solution
            or a folder.
        </p>
    }

    <ul class="tree-list">
        @foreach (var project in Projects)
        {
            var open = _openProjects.Contains(project.ProjectName);
            var use = $"use project {project.ProjectName}";
            var current = ProjectTree.IsCurrent(project);

            <li class="tree-node">
                <div class="tree-row tree-project @(current ? "tree-current" : "")">
                    <button type="button" class="tree-twisty @(open ? "tree-twisty-open" : "")"
                            aria-expanded="@open"
                            title="@(open ? "Collapse" : "Expand")"
                            @onclick="() => ToggleProject(project.ProjectName)">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m9 6 6 6-6 6" />
                        </svg>
                    </button>

                    <button type="button" class="tree-name"
                            @onclick="() => ToggleProject(project.ProjectName)">
                        @project.ProjectName
                    </button>

                    @* Only once the node is open. A count beside a collapsed project would mean
                       walking every project on every repaint, which is exactly what the header
                       refuses to do: a number that lags the command you just ran is worse than
                       no number. Open, it is the length of the list underneath it. *@
                    @if (open)
                    {
                        <span class="tree-count">@Tree.ClassesOf(project).Count</span>
                    }

                    @* Through the pipeline, never by setting ProjectManager.CurrentProject here:
                       the session carries its own current project between turns and would
                       overwrite anything set behind its back on the very next command. *@
                    <button type="button" class="tree-use" title="@use"
                            disabled="@(Disabled || current)"
                            @onclick="() => Run(use)">Use</button>
                </div>

                @if (open)
                {
                    <ul class="tree-list tree-classes">
                        @if (Tree.ClassesOf(project).Count == 0)
                        {
                            <li class="tree-none">No classes yet</li>
                        }

                        @foreach (var entry in Tree.ClassesOf(project))
                        {
                            var entryOpen = _openClasses.Contains(entry.File);
                            var show = $"show class {entry.Name}";
                            var found = entry.File.Length > 0;

                            <li class="tree-node">
                                <div class="tree-row">
                                    <button type="button"
                                            class="tree-twisty @(entryOpen ? "tree-twisty-open" : "")"
                                            aria-expanded="@entryOpen"
                                            disabled="@(!found)"
                                            title="@(entryOpen ? "Collapse" : "Expand")"
                                            @onclick="() => ToggleClass(entry.File)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.5" stroke-linecap="round"
                                             stroke-linejoin="round" aria-hidden="true">
                                            <path d="m9 6 6 6-6 6" />
                                        </svg>
                                    </button>

                                    @* `show class` only reads. Running it on a click is safe, and a
                                       tree you have to click twice to use is one people stop using.
                                       Nothing that writes is ever a click away in here. *@
                                    <button type="button" class="tree-name tree-open-class"
                                            disabled="@Disabled"
                                            title="@show"
                                            @onclick="() => Run(show)">@entry.Name</button>
                                </div>

                                @if (entryOpen)
                                {
                                    <ul class="tree-list tree-members">
                                        @if (Tree.MembersOf(entry).Count == 0)
                                        {
                                            <li class="tree-none">Nothing public</li>
                                        }

                                        @foreach (var member in Tree.MembersOf(entry))
                                        {
                                            <li class="tree-member">
                                                <span class="tree-glyph @(member.IsMethod ? "tree-glyph-method" : "")"
                                                      aria-hidden="true"></span>
                                                <span class="tree-member-name">@Label(member)</span>
                                                <span class="tree-member-type">@member.Type</span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
</nav>

@code {
    /// <summary>Which projects are open, by name.</summary>
    private readonly HashSet<string> _openProjects = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// Which classes are open, by file path.
    /// </summary>
    /// <remarks>
    /// By path rather than by name: two projects in one solution may both declare a
    /// <c>Customer</c>, and keying on the name would open and close them together.
    /// </remarks>
    private readonly HashSet<string> _openClasses = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired]
    public ProjectTree Tree { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<ProjectMetaData> Projects { get; set; } = [];

    /// <summary>Whether a command is in flight, in which case nothing here may start another.</summary>
    /// <remarks>
    /// One command at a time is the session's rule, not this component's: the engine keeps static
    /// state and captures the console globally, so a second command started from the tree while
    /// the first is running would write into the wrong buffer.
    /// </remarks>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised with a command the tree wants run.</summary>
    [Parameter]
    public EventCallback<string> OnCommand { get; set; }

    /// <summary>A member as it reads in the tree. Brackets mark a method as a method.</summary>
    private static string Label(TreeMember member) => member.IsMethod ? member.Name + "()" : member.Name;

    private void ToggleProject(string name)
    {
        if (!_openProjects.Remove(name))
            _openProjects.Add(name);
    }

    private void ToggleClass(string file)
    {
        if (file.Length == 0)
            return;

        if (!_openClasses.Remove(file))
            _openClasses.Add(file);
    }

    private Task Run(string command)
        => Disabled ? Task.CompletedTask : OnCommand.InvokeAsync(command);
}
