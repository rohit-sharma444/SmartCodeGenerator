namespace DocumentSearcherService;

using System.Collections.Concurrent;
using DocumentFormat.OpenXml.Packaging;
using NPOI.HSSF.UserModel;
using NPOI.SS.UserModel;
using NPOI.XSSF.UserModel;
using System.Threading.Tasks;
using UglyToad.PdfPig;

public sealed class SearchResult
{
    public string FilePath { get; set; } = "";
    public string FileType { get; set; } = "";
    public string MatchPreview { get; set; } = "";
}

public static class DocumentSearcherService
{
    public static Task<List<SearchResult>> SearchDocumentsInFolderAsync(
        string folderPath,
        string searchText)
    {
        return Task.Run(() => SearchDocumentsInFolder(folderPath, searchText));
    }

    public static List<SearchResult> SearchDocumentsInFolder(
        string folderPath,
        string searchText)
    {
        if (!Directory.Exists(folderPath))
            throw new DirectoryNotFoundException(folderPath);

        if (string.IsNullOrWhiteSpace(searchText))
            throw new ArgumentException(nameof(searchText));

        var results = new ConcurrentBag<SearchResult>();

        var files = Directory.EnumerateFiles(
            folderPath,
            "*.*",
            SearchOption.AllDirectories)
            .Where(f =>
                f.EndsWith(".txt", StringComparison.OrdinalIgnoreCase) ||
                f.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ||
                f.EndsWith(".docx", StringComparison.OrdinalIgnoreCase) ||
                f.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase) ||
                f.EndsWith(".xls", StringComparison.OrdinalIgnoreCase));

        Parallel.ForEach(files, file =>
        {
            try
            {
                SearchResult? result = Path.GetExtension(file).ToLower() switch
                {
                    ".txt" => SearchTxt(file, searchText),
                    ".pdf" => SearchPdf(file, searchText),
                    ".docx" => SearchDocx(file, searchText),
                    ".xls" => SearchExcel(file, searchText),
                    ".xlsx" => SearchExcel(file, searchText),
                    _ => null
                };

                if (result != null)
                    results.Add(result);
            }
            catch (Exception ex)
            {
                // Suppress noise for known, non-actionable errors (access denied, password-protected, corrupt headers, missing native libs)
                if (!IsHarmlessException(ex))
                {
                    Console.WriteLine($"Error: {file} -> {ex.Message}");
                }
            }
        });

        return results.ToList();
    }

    private static SearchResult? SearchTxt(
        string filePath,
        string searchText)
    {
        foreach (var line in File.ReadLines(filePath))
        {
            if (line.Contains(searchText,
                StringComparison.OrdinalIgnoreCase))
            {
                return new SearchResult
                {
                    FilePath = filePath,
                    FileType = "TXT",
                    MatchPreview = line
                };
            }
        }

        return null;
    }

    private static SearchResult? SearchPdf(
        string filePath,
        string searchText)
    {
        try
        {
            using var document = PdfDocument.Open(filePath);

            foreach (var page in document.GetPages())
            {
                var text = page.Text;

                if (text.Contains(searchText,
                    StringComparison.OrdinalIgnoreCase))
                {
                    return new SearchResult
                    {
                        FilePath = filePath,
                        FileType = "PDF",
                        MatchPreview = ExtractPreview(text, searchText)
                    };
                }
            }

            return null;
        }
        catch (Exception ex) when (IsPasswordProtectedException(ex))
        {
            // ignore password-protected / encrypted PDFs
            return null;
        }
        catch
        {
            throw;
        }
    }

    private static SearchResult? SearchDocx(
        string filePath,
        string searchText)
    {
        try
        {
            using var document =
                WordprocessingDocument.Open(filePath, false);

            var body = document.MainDocumentPart?
                .Document.Body?
                .InnerText;

            if (!string.IsNullOrEmpty(body) &&
                body.Contains(searchText,
                StringComparison.OrdinalIgnoreCase))
            {
                return new SearchResult
                {
                    FilePath = filePath,
                    FileType = "DOCX",
                    MatchPreview = ExtractPreview(body, searchText)
                };
            }

            return null;
        }
        catch (Exception ex) when (IsPasswordProtectedException(ex))
        {
            // ignore password-protected / encrypted DOCX
            return null;
        }
        catch
        {
            throw;
        }
    }

    private static SearchResult? SearchExcel(
        string filePath,
        string searchText)
    {
        try
        {
            using var stream = File.OpenRead(filePath);

            IWorkbook workbook =
                filePath.EndsWith(".xls")
                ? new HSSFWorkbook(stream)
                : new XSSFWorkbook(stream);

            for (int i = 0; i < workbook.NumberOfSheets; i++)
            {
                var sheet = workbook.GetSheetAt(i);

                for (int rowIndex = 0;
                     rowIndex <= sheet.LastRowNum;
                     rowIndex++)
                {
                    var row = sheet.GetRow(rowIndex);

                    if (row == null)
                        continue;

                    foreach (var cell in row.Cells)
                    {
                        var value = cell.ToString();

                        if (!string.IsNullOrEmpty(value) &&
                            value.Contains(searchText,
                            StringComparison.OrdinalIgnoreCase))
                        {
                            return new SearchResult
                            {
                                FilePath = filePath,
                                FileType = "EXCEL",
                                MatchPreview = value
                            };
                        }
                    }
                }
            }

            return null;
        }
        catch (Exception ex) when (IsPasswordProtectedException(ex))
        {
            // ignore password-protected / encrypted Excel files
            return null;
        }
        catch
        {
            throw;
        }
    }

    private static bool IsPasswordProtectedException(Exception ex)
    {
        if (ex == null) return false;

        // Inspect message and inner exceptions for common indicators
        Exception? e = ex;
        while (e != null)
        {
            var msg = e.Message ?? string.Empty;
            if (msg.IndexOf("password", StringComparison.OrdinalIgnoreCase) >= 0 ||
                msg.IndexOf("encrypted", StringComparison.OrdinalIgnoreCase) >= 0 ||
                msg.IndexOf("password protected", StringComparison.OrdinalIgnoreCase) >= 0 ||
                msg.IndexOf("encryptedPackage", StringComparison.OrdinalIgnoreCase) >= 0 ||
                msg.IndexOf("The document is encrypted", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                return true;
            }

            e = e.InnerException;
        }

        return false;
    }

    private static string ExtractPreview(
        string text,
        string searchText,
        int radius = 40)
    {
        int index = text.IndexOf(
            searchText,
            StringComparison.OrdinalIgnoreCase);

        if (index < 0)
            return "";

        int start = Math.Max(0, index - radius);
        int length = Math.Min(
            text.Length - start,
            searchText.Length + radius * 2);

        return text.Substring(start, length)
            .Replace(Environment.NewLine, " ");
    }
}