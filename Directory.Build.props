<Project>

  <!--
    Shared build settings for every project in the solution. Individual projects
    only need to declare what is specific to them (e.g. <OutputType>Exe</OutputType>
    or package references). TreatWarningsAsErrors is deliberately NOT set here so
    local iteration is never blocked by a warning; CI enforces a clean build via
    `-warnaserror` on the build step instead.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      Shared by every project because they ship as one thing. The CLI reports it on the banner
      and in `status` via VersionInfo, which trims the "+<sha>" the SDK appends to
      AssemblyInformationalVersion.
    -->
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
