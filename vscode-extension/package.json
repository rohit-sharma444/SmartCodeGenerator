{
  "name": "smartcodegen-vscode",
  "displayName": "SmartCodeGen",
  "description": "Drive the SmartCodeGenerator CLI from an in-editor REPL panel.",
  "version": "0.0.1",
  "publisher": "smartcodegen-dev",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-sharma444/SmartCodeGenerator.git"
  },
  "engines": { "vscode": "^1.85.0" },
  "main": "./out/extension.js",
  "activationEvents": ["onView:smartcodegen.panel"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "smartcodegen", "title": "SmartCodeGen", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "smartcodegen": [
        { "id": "smartcodegen.panel", "name": "SmartCodeGen", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "smartcodegen.restartEngine", "title": "SmartCodeGen: Restart Engine" },
      { "command": "smartcodegen.locateRepository", "title": "SmartCodeGen: Locate Checkout" },
      { "command": "smartcodegen.clearTranscript", "title": "SmartCodeGen: Clear Transcript" },
      { "command": "smartcodegen.focusInput", "title": "SmartCodeGen: Focus Input" }
    ],
    "configuration": {
      "title": "SmartCodeGen",
      "properties": {
        "smartcodegen.repositoryPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to your SmartCodeGenerator checkout — the folder containing the CodeGenerator project. Only needed when the folder you have open is NOT that checkout (or inside one), which is the usual case: the open folder is where generated code goes. The last checkout used is remembered automatically, so this is normally set once, or not at all. \"SmartCodeGen: Locate Checkout\" sets it for you. Takes effect immediately."
        },
        "smartcodegen.autoOpenGenerated": {
          "type": "boolean",
          "default": true,
          "description": "When the tool creates or changes files, open and reveal them in the editor automatically."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node --import tsx --test test/*.test.ts",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies -o smartcodegen-vscode.vsix",
    "install-ext": "code --install-extension smartcodegen-vscode.vsix --force"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
